<Window x:Class="TestWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:TestWpf.Converters"
        xmlns:models="clr-namespace:TestWpf.Models"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignWidth="1060" d:DesignHeight="820"
        Title="S7-1200 读写工具"
        Width="1060" Height="820"
        MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <conv:BoolToBackgroundConverter x:Key="BgConverter"/>
        <conv:BoolToIndicatorConverter x:Key="IndicatorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ===== 侧边栏组件 ===== -->
        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="SidebarInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- ComboBox 下拉项样式 -->
        <Style x:Key="TrendComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPopupBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Section 标题 ===== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ===== TabHeader（MaterialDesign 风格） ===== -->
        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"
                                Cursor="Hand" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===== 主结构：sidebar + 内容区 ===== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== 侧边栏 ====== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,16">

                    <!-- 标题 + 主题切换 -->
                    <Border Background="{DynamicResource CardBackground}" Padding="14,6"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚙ PLC 连接" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="btnTheme" Content="🌙"
                                    Style="{StaticResource FlatButton}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    FontSize="16" Width="32" Height="32" Padding="0"
                                    Click="BtnTheme_Click" ToolTip="切换暗色/亮色主题"/>
                        </Grid>
                    </Border>

                    <!-- 连接配置 -->
                    <StackPanel Margin="16,12,16,0">
                        <!-- 网卡选择 -->
                        <TextBlock Text="本机网卡" Style="{StaticResource SidebarLabel}"/>
                        <ComboBox x:Name="cmbAdapter"
          Background="{DynamicResource InputBackground}"
          Foreground="{DynamicResource TextPrimary}"
          BorderBrush="{DynamicResource CardBorder}"
          Height="30" Padding="8,0"
          DisplayMemberPath="Display"/>
                        <TextBlock Text="IP 地址" Style="{StaticResource SidebarLabel}"/>
                        <TextBox x:Name="txtIP" Text="192.168.0.1" Style="{StaticResource SidebarInput}"/>

                        <TextBlock Text="端口（默认 102）" Style="{StaticResource SidebarLabel}"/>
                        <TextBox x:Name="txtPort" Text="102" Style="{StaticResource SidebarInput}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="机架" Style="{StaticResource SidebarHint}"/>
                                <TextBox x:Name="txtRack" Text="0" Style="{StaticResource SidebarInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="槽位" Style="{StaticResource SidebarHint}"/>
                                <TextBox x:Name="txtSlot" Text="0" Style="{StaticResource SidebarInput}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 连接/断开 -->
                    <StackPanel Margin="16,14,16,0" Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button x:Name="btnConnect" Content="● 连接"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentGreen}" Foreground="White"
                                Padding="0" Height="34" FontWeight="Bold"
                                Click="BtnConnect_Click" Width="100" Margin="0,0,16,0"/>
                        <Button x:Name="btnDisconnect" Content="○ 断开"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentRed}" Foreground="White"
                                Padding="0" Height="34" FontWeight="Bold" IsEnabled="False"
                                Click="BtnDisconnect_Click" Width="100"/>
                    </StackPanel>

                    <!-- 连接状态 -->
                    <Border Margin="16,10,16,0" Background="{DynamicResource CardBackground}"
                            CornerRadius="4" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="indicator" Width="10" Height="10"
                                     Fill="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtStatus" Text="未连接"
                                       Foreground="{DynamicResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>


                    <!-- ====== 导入 DB/UDT ====== -->
                    <StackPanel Margin="16,16,16,4">
                        <TextBlock Text="📂 导入 DB 结构" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📄 导入 .db"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource AccentBlue}" Foreground="White"
                                    Height="30" FontWeight="Bold" Click="BtnImportDb_Click"/>
                            <Button Grid.Column="2" Content="📄 导入 .udt"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource AccentPurple}" Foreground="White"
                                    Height="30" FontWeight="Bold" Click="BtnImportUdt_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ====== 已导入列表 ====== -->
                    <StackPanel Margin="16,10,16,0">
                        <TextBlock Text="已导入 DB" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <ItemsControl x:Name="listImportedDb" MaxHeight="100">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="4,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalSize, StringFormat='{}{0}B'}"
                                                       FontSize="10" Foreground="{DynamicResource TextDim}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="×" Style="{StaticResource FlatButton}"
                                                    Background="Transparent" Foreground="{DynamicResource AccentRed}"
                                                    FontSize="14" Width="22" Height="22" Padding="0"
                                                    Click="BtnDeleteImportedDb_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="16,6,16,0">
                        <TextBlock Text="已导入 UDT" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <ItemsControl x:Name="listImportedUdt" MaxHeight="100">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="4,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding UdtName}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                            <Button Grid.Column="1" Content="×" Style="{StaticResource FlatButton}"
                                                    Background="Transparent" Foreground="{DynamicResource AccentRed}"
                                                    FontSize="14" Width="22" Height="22" Padding="0"
                                                    Click="BtnDeleteImportedUdt_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource DividerColor}" Margin="16,8,16,0"/>

                    <StackPanel Margin="16,12,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⏱ 轮询" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Column="2" x:Name="txtPollLatency" Text=""
                                       Foreground="{DynamicResource TextDim}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPollInterval" Text="50" Style="{StaticResource SidebarInput}" Height="28"/>
                            <TextBlock Grid.Column="1" Text="ms" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <Button x:Name="btnStartPoll" Content="▶ 启动轮询"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentGreen}" Foreground="White"
                                Height="36" FontWeight="Bold" Click="BtnStartPoll_Click"
                                IsEnabled="False"/>
                        <Button x:Name="btnStopPoll" Content="■ 停止轮询"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentRed}" Foreground="White"
                                Height="36" FontWeight="Bold" Click="BtnStopPoll_Click"
                                IsEnabled="False" Margin="0,8,0,0"/>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="4"
                                Padding="8,6" Margin="0,8,0,0">
                            <TextBlock x:Name="txtPollStatus" Text="就绪"
                                       Foreground="{DynamicResource TextDim}" FontSize="12"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ====== 主内容区 ====== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab 栏 -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                <TabControl x:Name="tabControl" Height="40"
                            Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="8,0"/>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="📋 I/Q/M 区" Style="{StaticResource TabHeader}"/>
                    <TabItem Header="📈 趋势图" Style="{StaticResource TabHeader}"/>
                    <TabItem Header="📊 仪表盘" Style="{StaticResource TabHeader}"/>
                </TabControl>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1">

                <!-- ===== 手动模式 ===== -->
                <ScrollViewer x:Name="manualPanel" Padding="16,8" VerticalScrollBarVisibility="Auto"
                              Visibility="Visible" Cursor="Hand" Style="{DynamicResource MaterialDesignScrollViewer}">
                    <StackPanel>
                        <!-- I 区 -->
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{DynamicResource AccentBlue}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="I 区（输入 · 只读）" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="txtIAddress" Text="0,1"
                                             Style="{StaticResource SidebarInput}" Width="170" Margin="8,0,0,0"/>
                                    <Button Grid.Column="3" x:Name="btnIRead" Content="▶ 读取"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{DynamicResource AccentBlue}" Foreground="White"
                                            Padding="30,5" FontWeight="Bold" IsEnabled="False"
                                            Click="BtnIRead_Click" Margin="8,0,0,0"/>
                                </Grid>
                                <!-- 位表头 -->
                                <Grid Margin="0,0,0,4" Height="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="272"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="地址" Foreground="{DynamicResource TextDim}" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="位0" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位1" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位2" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位3" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位4" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位5" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位6" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位7" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="HEX" Foreground="{DynamicResource TextDim}"
                                               FontSize="11" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="listIRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:ByteRowViewModel">
                                            <Border BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="0,0,0,1" Padding="3,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                               FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Bits}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:BitViewModel">
                                                                <Border Width="32" Height="28" CornerRadius="4" Margin="1"
                                                                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                                                        Background="{Binding IsSet, Converter={StaticResource BgConverter}}">
                                                                    <TextBlock Text="{Binding DisplayChar}" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" Foreground="White"
                                                                               FontWeight="Bold" FontSize="14"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="2" Text="{Binding HexText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentOrange}" FontWeight="Bold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="txtIEmpty" Text="输入字节地址后点击 [▶ 读取]"
                                           Foreground="{DynamicResource TextDim}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Q 区 -->
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{DynamicResource AccentGreen}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Q 区（输出 · 可读写）" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="txtQAddress" Text="0"
                                             Style="{StaticResource SidebarInput}" Width="170" Margin="8,0,0,0"/>
                                    <Button Grid.Column="3" x:Name="btnQRead" Content="▶ 读取"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{DynamicResource AccentBlue}" Foreground="White"
                                            Padding="30,5" FontWeight="Bold" IsEnabled="False"
                                            Click="BtnQRead_Click" Margin="8,0,8,0"/>
                                    <Button Grid.Column="4" x:Name="btnQWriteMode" Content="🔒 写入模式 (关)"
                                            Style="{StaticResource FlatButton}"
                                            Background="{DynamicResource TextDim}" Foreground="White"
                                            Padding="10,5" FontWeight="Bold" FontSize="11" IsEnabled="False"
                                            Click="BtnQWriteMode_Click"/>
                                </Grid>
                                <!-- 位表头 -->
                                <Grid Margin="0,0,0,4" Height="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="272"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="地址" Foreground="{DynamicResource TextDim}" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="位0" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位1" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位2" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位3" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位4" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位5" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位6" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                        <TextBlock Text="位7" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="HEX" Foreground="{DynamicResource TextDim}"
                                               FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="状态" Foreground="{DynamicResource TextDim}"
                                               FontSize="11" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="listQRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:ByteRowViewModel">
                                            <Border BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="0,0,0,1" Padding="3,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                               FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Bits}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:BitViewModel">
                                                                <Border Width="32" Height="28" CornerRadius="4" Margin="1"
                                                                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                                                        Background="{Binding IsSet, Converter={StaticResource BgConverter}}"
                                                                        MouseDown="BitBlock_MouseDown" ToolTip="点击切换">
                                                                    <TextBlock Text="{Binding DisplayChar}" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" Foreground="White"
                                                                               FontWeight="Bold" FontSize="14"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="2" Text="{Binding HexText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
