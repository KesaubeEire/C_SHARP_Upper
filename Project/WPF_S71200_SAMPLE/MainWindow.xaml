<Window x:Class="TestWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:TestWpf.Converters"
        xmlns:controls="clr-namespace:TestWpf.Controls.Common"
        xmlns:sidebar="clr-namespace:TestWpf.Controls.Sidebar"
        xmlns:trend="clr-namespace:TestWpf.Controls.Trend"
        xmlns:gauge="clr-namespace:TestWpf.Controls.Gauge"
        mc:Ignorable="d"
        d:DesignWidth="1060" d:DesignHeight="820"
        Title="S7-1200 读写工具"
        Width="1060" Height="820"
        MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <!-- 所有样式已移入 Styles.xaml / App.xaml -->
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== 侧边栏 ====== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,16">
                    <!-- 标题 + 主题切换 -->
                    <Border Background="{DynamicResource CardBackground}" Padding="14,6"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚙ PLC 连接" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="btnTheme" Content="🌙"
                                    Style="{StaticResource FlatButton}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    FontSize="16" Width="32" Height="32" Padding="0"
                                    Click="OnThemeToggle" ToolTip="切换暗色/亮色主题"/>
                        </Grid>
                    </Border>

                    <!-- 连接面板 -->
                    <sidebar:ConnectionPanel x:Name="connectionPanel"/>

                    <!-- 导入 DB/UDT -->
                    <sidebar:ImportPanel x:Name="importPanel"/>

                    <!-- 轮询面板 -->
                    <sidebar:PollingPanel x:Name="pollingPanel"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ====== 主内容区 ====== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab 栏 -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                <TabControl x:Name="tabControl" Height="40"
                            Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="8,0"/>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="📋 I/Q/M 区" Style="{StaticResource TabHeader}"/>
                    <TabItem Header="📈 趋势图" Style="{StaticResource TabHeader}"/>
                    <TabItem Header="📊 仪表盘" Style="{StaticResource TabHeader}"/>
                </TabControl>
            </Border>

            <!-- Tab 内容 -->
            <Grid Grid.Row="1">
                <!-- Tab 0: I/Q/M -->
                <ScrollViewer x:Name="ioPanel" Padding="16,8" VerticalScrollBarVisibility="Auto"
                              Style="{DynamicResource MaterialDesignScrollViewer}"
                              Visibility="Visible">
                    <StackPanel>
                        <controls:AreaPanel x:Name="iPanel" AreaType="I" IsReadOnly="True"/>
                        <controls:AreaPanel x:Name="qPanel" AreaType="Q"/>
                        <controls:AreaPanel x:Name="mPanel" AreaType="M"/>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Opacity="0.55">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="DB 区：请在「自动轮询」页配置" FontSize="14"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Rectangle Height="24" Fill="Transparent"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 1: 趋势图 -->
                <trend:TrendPanel x:Name="trendPanel" Visibility="Collapsed"/>

                <!-- Tab 2: 仪表盘 -->
                <gauge:GaugePanel x:Name="gaugePanel" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
