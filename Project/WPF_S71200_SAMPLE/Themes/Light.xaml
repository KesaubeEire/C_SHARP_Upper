<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 亮色主题 ===== -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#E8E8EC"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D0D0D8"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#222233"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#666677"/>
    <SolidColorBrush x:Key="TextDim" Color="#999999"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DividerColor" Color="#D0D0D8"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2980B9"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#1E8449"/>
    <SolidColorBrush x:Key="AccentRed" Color="#C0392B"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#8E44AD"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#D68910"/>
    <SolidColorBrush x:Key="DisabledBackground" Color="#E0E0E0"/>

    <!-- MaterialDesign 亮色主题覆盖 -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MaterialDesignPopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MaterialDesignTableAlternateRow" Color="#F5F5F8"/>
    <SolidColorBrush x:Key="MaterialDesignSelection" Color="#D0D0D8"/>
    <SolidColorBrush x:Key="MaterialDesignTextFieldBoxBackground" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="MaterialDesignTextFieldBoxHoverBackground" Color="#E8E8EC"/>

</ResourceDictionary>
