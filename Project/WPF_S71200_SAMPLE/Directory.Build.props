<Project>

  <!--
    .NET solution-wide build settings. Imported automatically into every project
    under the WPF_S71200_SAMPLE directory, so the coding standard lives in
    exactly one place.
  -->

  <PropertyGroup>
    <!-- Language / runtime baseline. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Static analysis: Recommended (strict but not maximal — pre-existing
         codebase; analysis rules tune reactively in .editorconfig). -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- Reproducible builds. -->
    <Deterministic>true</Deterministic>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <!-- IDE0005 (remove unnecessary usings) requires GenerateDocumentationFile.
         We enable it to make that rule enforce; suppress CS1591 (missing doc
         comments) since we don't require XML doc on every member.
         NU1701: OpenTK/SkiaSharp transitive deps target netfx, not net10 —
         pre-existing, accepted. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
  </PropertyGroup>

  <!-- Third-party analyzers applied to every project. Explicit versions here
       to survive WPF build-wrangler (_wpftmp temp projects that skip CPM). -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.101">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
