<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 全局暗色主题 -->
    <Color x:Key="BgColor">#0F0F1A</Color>
    <Color x:Key="CardBg">#1A1A2E</Color>
    <Color x:Key="BorderColor">#2A2A4A</Color>
    <Color x:Key="TextColor">#E0E0E0</Color>

    <Style TargetType="Window">
        <Setter Property="Background" Value="#0F0F1A"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="CaretBrush" Value="#3498DB"/>
    </Style>

</ResourceDictionary>
