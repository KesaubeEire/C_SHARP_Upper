<UserControl x:Class="TestWpf.Controls.Common.AreaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:TestWpf.Models"
             xmlns:controls="clr-namespace:TestWpf.Controls.Common"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             x:Name="root">
    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <StackPanel>
            <!-- 标题栏：标识 + 地址输入 + 读取按钮 + 写模式切换 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="12" Height="12"
                         Fill="{Binding AreaColor, ElementName=root}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding AreaLabel, ElementName=root}"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{Binding AreaColor, ElementName=root}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="txtAddress"
                         Style="{StaticResource SidebarInput}"
                         Width="170" Margin="8,0,0,0"/>
                <Button Grid.Column="3" x:Name="btnRead" Content="▶ 读取"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource AccentBlue}" Foreground="White"
                        Padding="30,5" FontWeight="Bold"
                        Click="OnReadClick" Margin="8,0,8,0"/>
                <Button Grid.Column="4" x:Name="btnWriteMode" Content="🔒 写入模式 (关)"
                        Style="{StaticResource FlatButton}"
                        Background="{DynamicResource TextDim}" Foreground="White"
                        Padding="10,5" FontWeight="Bold" FontSize="11"
                        Click="OnWriteModeClick"/>
            </Grid>

            <!-- 位表头 -->
            <Grid Margin="0,0,0,4" Height="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="地址" Foreground="{DynamicResource TextDim}" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="位0" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位1" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位2" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位3" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位4" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位5" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位6" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="位7" Width="34" Foreground="{DynamicResource TextDim}" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="HEX" Foreground="{DynamicResource TextDim}"
                           FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="colStatusHeader" Text="状态" Foreground="{DynamicResource TextDim}"
                           FontSize="11" HorizontalAlignment="Center"/>
            </Grid>

            <!-- 数据行 -->
            <ItemsControl x:Name="listRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ByteRowViewModel">
                        <controls:ByteRow BitToggled="OnRowBitToggled"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空状态 -->
            <TextBlock x:Name="txtEmpty"
                       Foreground="{DynamicResource TextDim}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
