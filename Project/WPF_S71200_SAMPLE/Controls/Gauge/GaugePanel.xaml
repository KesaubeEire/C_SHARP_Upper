<UserControl x:Class="TestWpf.Controls.Gauge.GaugePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="740">
    <ScrollViewer Padding="16,8" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- ===== AngularGauge #1: 单值实心表盘 ===== -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <lvc:PieChart Grid.Column="0" x:Name="angularGaugeSingle"
                                  InitialRotation="-225" MaxAngle="270"
                                  MinValue="0" MaxValue="100"
                                  Width="360" Height="280" Margin="10"
                                  TooltipPosition="Hidden">
                        <lvc:PieChart.Series>
                            <lvc:SeriesCollection>
                                <!-- 值弧：显示填充部分，颜色和 GaugeValue 在 C# 中设置 -->
                                <lvc:XamlAngularGaugeSeries x:Name="gaugeArc"
                                    GaugeValue="0"
                                    MaxRadialColumnWidth="25"
                                    CornerRadius="4"/>
                            </lvc:SeriesCollection>
                        </lvc:PieChart.Series>
                        <lvc:PieChart.VisualElements>
                            <lvc:VisualsCollection>
                                <lvc:XamlNeedle x:Name="gaugeNeedle" Width="20"/>
                                <lvc:XamlAngularTicks LabelsSize="14" LabelsOuterOffset="10"
                                                      OuterOffset="55" TicksLength="15"/>
                            </lvc:VisualsCollection>
                        </lvc:PieChart.VisualElements>
                    </lvc:PieChart>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🎯 伺服位置" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentOrange}" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource WindowBackground}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="当前值" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="txtGaugeVal" Text="0.0 mm" FontSize="28"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="最小值" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                <TextBox x:Name="txtMin" Text="0"
                                         Style="{StaticResource SidebarInput}" Height="28"
                                         TextChanged="OnRangeChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最大值" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                <TextBox x:Name="txtMax" Text="100"
                                         Style="{StaticResource SidebarInput}" Height="28"
                                         TextChanged="OnRangeChanged"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="弧厚度" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                            <Slider x:Name="sldThickness" Minimum="5" Maximum="60" Value="20"
                                    TickFrequency="5" TickPlacement="BottomRight"
                                    ValueChanged="OnThicknessChanged"/>
                        </StackPanel>
                        <Button x:Name="btnLinkMock" Content="🔗 联动 Mock 数据"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentBlue}" Foreground="White"
                                Height="34" FontWeight="Bold" Click="OnLinkMock"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== AngularGauge #2: 多区段仪表 ===== -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <lvc:PieChart Grid.Column="0" x:Name="angularGaugeMulti"
                                  InitialRotation="-225" MaxAngle="270"
                                  MinValue="0" MaxValue="100"
                                  Width="360" Height="280" Margin="10"
                                  TooltipPosition="Hidden">
                        <lvc:PieChart.Series>
                            <lvc:SeriesCollection>
                                <lvc:XamlAngularGaugeSeries x:Name="seg0" GaugeValue="0" OuterRadiusOffset="15" MaxRadialColumnWidth="14"/>
                                <lvc:XamlAngularGaugeSeries x:Name="seg1" GaugeValue="0" OuterRadiusOffset="33" MaxRadialColumnWidth="14"/>
                                <lvc:XamlAngularGaugeSeries x:Name="seg2" GaugeValue="0" OuterRadiusOffset="51" MaxRadialColumnWidth="14"/>
                                <lvc:XamlAngularGaugeSeries x:Name="seg3" GaugeValue="0" OuterRadiusOffset="69" MaxRadialColumnWidth="14"/>
                                <lvc:XamlAngularGaugeSeries x:Name="seg4" GaugeValue="0" OuterRadiusOffset="87" MaxRadialColumnWidth="14"/>
                            </lvc:SeriesCollection>
                        </lvc:PieChart.Series>
                        <lvc:PieChart.VisualElements>
                            <lvc:VisualsCollection>
                                <lvc:XamlAngularTicks LabelsSize="12" LabelsOuterOffset="5"
                                                      OuterOffset="110" TicksLength="10"/>
                            </lvc:VisualsCollection>
                        </lvc:PieChart.VisualElements>
                    </lvc:PieChart>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🔴 多区段状态" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentGreen}" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="listGaugeSections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     Fill="{Binding Color}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Margin="6,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Value, StringFormat='{}{0:F1}'}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBlue}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Rectangle Height="24" Fill="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
