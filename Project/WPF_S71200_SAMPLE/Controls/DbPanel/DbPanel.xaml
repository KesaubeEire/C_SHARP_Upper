<UserControl x:Class="TestWpf.Controls.DbPanel.DbPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:TestWpf.Models"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="740"
             x:Name="root">
    <ScrollViewer Padding="16,8" VerticalScrollBarVisibility="Auto"
                  Style="{DynamicResource MaterialDesignScrollViewer}">
        <StackPanel>
            <!-- ===== 顶部：导入 + 配置 ===== -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📦 DB 块读取" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,10"/>

                    <!-- 第一行：导入 + DB号 + 读取按钮 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="btnImportDb" Content="📂 导入 .db"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="42,0"
                                Click="OnImportDb" Margin="0,8,0,8"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="48">
                            <TextBlock Text="DB" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="txtDbNumber" Text="1"
                                     Style="{StaticResource SidebarInput}"
                                     Width="60" Height="28" HorizontalContentAlignment="Center" 
                                     Margin="10,10"/>
                        </StackPanel>

                        <Button Grid.Column="4" x:Name="btnReadDb" Content="📡 读取 DB 块"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentGreen}" Foreground="White" FontWeight="Bold" Padding="50,0"
                                Click="OnReadDb" Margin="0,8,0,8"/>

                        <!-- 当前 DB 信息 -->
                        <TextBlock Grid.Column="5" x:Name="txtDbInfo"
                                   Text="未导入 DB 文件"
                                   FontSize="12" Foreground="{DynamicResource TextDim}"
                                   VerticalAlignment="Center" Margin="12,0,53,0" Grid.ColumnSpan="2" Height="16"/>

                        <!-- 清除按钮 -->
                        <Button Grid.Column="6" x:Name="btnClear" Content="✕ 清除"
                                Style="{StaticResource FlatButton}"
                                Background="Transparent"
                                Foreground="{DynamicResource AccentRed}"
                                FontSize="12" Padding="8,0"
                                Click="OnClear" ToolTip="清除当前 DB 数据" Margin="0,10,0,10"/>
                    </Grid>

                    <!-- 已导入 UDT 提示 -->
                    <TextBlock x:Name="txtUdtHint" Text=""
                               FontSize="11" Foreground="{DynamicResource TextDim}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 中间：变量列表 DataGrid ===== -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="0" Margin="0,0,0,12"
                    MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 表头 -->
                    <Border Grid.Row="0" Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="偏移量" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="变量名" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="数据类型" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="大小" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="读取值" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="5" Text="注释" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 变量行列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <Grid>
                            <ItemsControl x:Name="listVariables">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DbVariableDisplay}">
                                        <Border BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 偏移量 -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding OffsetDisplay}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"/>

                                                <!-- 变量名 -->
                                                <TextBlock Grid.Column="1"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text="{Binding UdtName, StringFormat=' [{0}]'}"
                                                         FontSize="10" Foreground="{DynamicResource TextDim}"
                                                         FontWeight="Normal"/>
                                                </TextBlock>

                                                <!-- 数据类型 -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DataType}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center"/>

                                                <!-- 大小 -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Size, StringFormat='{}{0}B'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center"/>

                                                <!-- 值 -->
                                                <Border Grid.Column="4"
                                                        Background="{DynamicResource InputBackground}"
                                                        BorderBrush="{DynamicResource CardBorder}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="8,3" Height="28"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Value}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBlue}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>

                                                <!-- 注释 -->
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding Comment}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- 空状态提示 -->
                            <Border x:Name="emptyState"
                                    Height="200" Visibility="Visible"
                                    Background="Transparent">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextDim}"/>
                                    <TextBlock Text="请导入 .db 文件并点击读取"
                                               FontSize="14" Foreground="{DynamicResource TextDim}"
                                               Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 底部状态栏 ===== -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 连接状态 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="statusIndicator" Width="10" Height="10"
                                 Fill="{DynamicResource AccentRed}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtStatus" Text="未连接"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- DB 大小 -->
                    <TextBlock Grid.Column="2" x:Name="txtDbSize" Text=""
                               FontSize="12" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center"/>

                    <!-- 操作信息 -->
                    <TextBlock Grid.Column="4" x:Name="txtOperationInfo" Text=""
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Rectangle Height="24" Fill="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
