<UserControl
    x:Class="WpfScada.Controls.Plc.LedIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="20"
    d:DesignWidth="20"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard
            x:Key="BlinkStory"
            AutoReverse="True"
            RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="ellipse"
                Storyboard.TargetProperty="Opacity"
                From="1.0"
                To="0.15"
                Duration="0:0:0.4" />
        </Storyboard>
    </UserControl.Resources>
    <Ellipse
        x:Name="ellipse"
        Width="{Binding Width, ElementName=root, FallbackValue=16}"
        Height="{Binding Height, ElementName=root, FallbackValue=16}"
        RenderOptions.EdgeMode="Aliased"
        Stroke="{DynamicResource ControlElevationBorderBrush}"
        StrokeThickness="0.5"
        ToolTip="{Binding ToolTipText, ElementName=root}">
        <Ellipse.Style>
            <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Quality, ElementName=root}" Value="Good">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Quality, ElementName=root}" Value="Bad">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Quality, ElementName=root}" Value="Warning">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Quality, ElementName=root}" Value="Info">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Ellipse.Style>
    </Ellipse>
</UserControl>
