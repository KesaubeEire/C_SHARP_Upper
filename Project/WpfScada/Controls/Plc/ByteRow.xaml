<UserControl
    x:Class="WpfScada.Controls.Plc.ByteRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WpfScada.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfScada.Controls.Plc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="root"
    d:DesignHeight="36"
    d:DesignWidth="400"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid MinHeight="32" Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>

        <ui:TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontTypography="BodyStrong"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding Label}" />

        <ItemsControl
            Grid.Column="1"
            VerticalAlignment="Center"
            ItemsSource="{Binding Bits}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:BitBlock DataContext="{Binding}" Toggled="OnBitBlockToggled" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBlock
            Grid.Column="2"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding HexText}" />

        <ui:TextBlock
            Grid.Column="3"
            VerticalAlignment="Center"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="已修改"
            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
