<UserControl
    x:Class="WpfScada.Controls.Plc.AlarmStatCards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </UserControl.Resources>
    <Border
        Margin="0,16,0,0"
        Padding="16,12"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  活动报警  -->
            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="活动报警" />
                    <ui:TextBlock
                        FontTypography="Title"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding ActiveCount}" />
                </StackPanel>
            </Border>

            <Rectangle
                Grid.Column="1"
                Width="1"
                Margin="12,4"
                Fill="{DynamicResource ControlElevationBorderBrush}" />

            <!--  未确认  -->
            <Border
                Grid.Column="2"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="未确认" />
                    <ui:TextBlock
                        FontTypography="Title"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding UnacknowledgedCount}" />
                </StackPanel>
            </Border>

            <Rectangle
                Grid.Column="3"
                Width="1"
                Margin="12,4"
                Fill="{DynamicResource ControlElevationBorderBrush}" />

            <!--  今日  -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="今日报警" />
                    <ui:TextBlock
                        FontTypography="Title"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding TodayCount}" />
                </StackPanel>
            </Border>

            <Rectangle
                Grid.Column="5"
                Width="1"
                Margin="12,4"
                Fill="{DynamicResource ControlElevationBorderBrush}" />

            <!--  搁置 + 紧急/严重  -->
            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="搁置" />
                        <ui:TextBlock
                            FontTypography="Title"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ShelvedCount}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="本时" />
                        <ui:TextBlock
                            FontTypography="Title"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ThisHourCount}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="紧急" />
                        <ui:TextBlock
                            FontTypography="Title"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding EmergencyCount}" />
                    </StackPanel>
                    <StackPanel>
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="严重" />
                        <ui:TextBlock
                            FontTypography="Title"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding CriticalCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  刷新按钮  -->
            <ui:Button
                Grid.Column="7"
                Margin="8,0,0,0"
                HorizontalAlignment="Right"
                Appearance="Secondary"
                Command="{Binding RefreshStatisticsCommand}"
                Content="刷新统计">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </Border>
</UserControl>
