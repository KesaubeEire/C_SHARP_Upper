<UserControl
    x:Class="WpfScada.Controls.Plc.AlarmDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Visibility="{Binding SelectedAlarm, Converter={StaticResource NullToVisibilityConverter}}">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAlarm, Converter={StaticResource NullToBoolConverter}}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!--  半透明遮罩  -->
        <Border
            x:Name="DetailBackdrop"
            Background="#20000000"
            MouseDown="OnBackdropMouseDown" />

        <!--  详情面板  -->
        <Border
            x:Name="DetailPanel"
            Width="320"
            Margin="0,0,0,0"
            Padding="0"
            HorizontalAlignment="Right"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="8,0,0,8">
            <Border.RenderTransform>
                <TranslateTransform X="320" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedAlarm, Converter={StaticResource NullToBoolConverter}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            DecelerationRatio="0.25"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                            To="0"
                                            Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            AccelerationRatio="0.25"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                            To="320"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border.Resources>
                <Style x:Key="DetailLabel" TargetType="ui:TextBlock">
                    <Setter Property="FontTypography" Value="Caption" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Margin" Value="0,8,0,2" />
                </Style>
                <Style x:Key="DetailValue" TargetType="ui:TextBlock">
                    <Setter Property="FontTypography" Value="Body" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Medium" />
                </Style>
            </Border.Resources>

            <Grid Background="{DynamicResource ControlFillColorInputActiveBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  面板头部：标题 + 关闭按钮  -->
                <Border
                    Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="报警详情" />
                        <ui:Button
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseClick"
                            Cursor="Hand"
                            ToolTip="关闭">
                            <ui:SymbolIcon FontSize="16" Symbol="Dismiss24" />
                        </ui:Button>
                    </Grid>
                </Border>

                <!--  内容  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="16,8"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="描述" />
                        <ui:TextBlock
                            Style="{StaticResource DetailValue}"
                            Text="{Binding SelectedAlarm.Description}"
                            TextWrapping="Wrap" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="变量" />
                        <ui:TextBlock
                            FontFamily="Consolas"
                            Style="{StaticResource DetailValue}"
                            Text="{Binding SelectedAlarm.VariableName}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Style="{StaticResource DetailLabel}" Text="当前值" />
                                <ui:TextBlock
                                    FontTypography="Subtitle"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="{Binding SelectedAlarm.CurrentValue, StringFormat=F2}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Style="{StaticResource DetailLabel}" Text="阈值" />
                                <ui:TextBlock
                                    FontTypography="Subtitle"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding SelectedAlarm.Threshold, StringFormat={}{0:F2}}" />
                            </StackPanel>
                        </Grid>

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="报警类型" />
                        <ui:TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.AlarmType}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="严重度" />
                        <ui:TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Severity}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="区域" />
                        <ui:TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Area}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="产生时间" />
                        <ui:TextBlock
                            FontFamily="Consolas"
                            Style="{StaticResource DetailValue}"
                            Text="{Binding SelectedAlarm.DateTimeText}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="状态" />
                        <ui:TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.StatusText}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="死区" />
                        <ui:TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Deadband, StringFormat=F2}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="确认人" />
                        <ui:TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.AcknowledgedBy, TargetNullValue=—}" />

                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="确认时间" />
                        <ui:TextBlock
                            FontFamily="Consolas"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding SelectedAlarm.AcknowledgedAt, TargetNullValue=—}" />

                        <!--  备注编辑  -->
                        <ui:TextBlock Style="{StaticResource DetailLabel}" Text="操作员备注" />
                        <TextBox
                            Margin="0,2,0,4"
                            AcceptsReturn="True"
                            MaxLines="3"
                            Text="{Binding SelectedAlarm.Comment, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,0,0,8"
                            Appearance="Primary"
                            Command="{Binding SaveCommentCommand}"
                            Content="保存备注" />

                        <!--  搁置操作  -->
                        <Rectangle
                            Height="1"
                            Margin="0,4"
                            Fill="{DynamicResource ControlElevationBorderBrush}" />
                        <TextBlock
                            Margin="0,4,0,4"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="搁置操作" />
                        <WrapPanel>
                            <ui:Button
                                Height="34"
                                Margin="0,0,4,4"
                                Command="{Binding ShelveAlarm1HCommand}"
                                CommandParameter="{Binding SelectedAlarm}"
                                Content="1 小时"
                                FontSize="12" />
                            <ui:Button
                                Height="34"
                                Margin="0,0,4,4"
                                Command="{Binding ShelveAlarm8HCommand}"
                                CommandParameter="{Binding SelectedAlarm}"
                                Content="8 小时"
                                FontSize="12" />
                            <ui:Button
                                Height="34"
                                Margin="0,0,4,4"
                                Command="{Binding ShelveAlarm24HCommand}"
                                CommandParameter="{Binding SelectedAlarm}"
                                Content="24 小时"
                                FontSize="12" />
                            <ui:Button
                                Height="34"
                                Margin="0,0,0,4"
                                Command="{Binding UnshelveAlarmCommand}"
                                CommandParameter="{Binding SelectedAlarm}"
                                Content="取消搁置"
                                FontSize="12" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
