<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="clr-namespace:WpfScada.Controls.Input"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  HistoryItem 的 DataTemplate  -->
    <DataTemplate x:Key="HistoryItemDataTemplate" DataType="{x:Type input:HistoryItem}">
        <Grid Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Value}" />
            <Button
                Grid.Column="1"
                Width="20"
                Height="20"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding RemoveCommand}"
                Cursor="Hand"
                ToolTip="删除此项">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="✕" />
            </Button>
        </Grid>
    </DataTemplate>

    <!--  HistorySuggestBox 默认样式 — 基于自动找到的父类样式  -->
    <Style BasedOn="{StaticResource {x:Type ui:AutoSuggestBox}}" TargetType="{x:Type input:HistorySuggestBox}">
        <Setter Property="ItemTemplate" Value="{StaticResource HistoryItemDataTemplate}" />
    </Style>

</ResourceDictionary>
