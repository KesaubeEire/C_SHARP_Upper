<Page
    x:Class="WpfScada.Views.Pages.Plc.DbMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfScada.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WpfScada.Models.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DB 块监控"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">

        <!--  ===== 顶部：导入 + 配置 =====  -->
        <Border
            Margin="0,0,0,12"
            Padding="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>
                <!--  第一行：导入 + DB号 + 读取 + 清除  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        x:Name="btnImportDb"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Appearance="Primary"
                        Click="OnImportDb">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                        导入 .db
                    </ui:Button>
                    <ui:Button
                        Grid.Column="1"
                        Margin="4,0"
                        Click="OnImportUdt">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                        导入 .udt
                    </ui:Button>
                    <StackPanel
                        Grid.Column="2"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontTypography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="DB 号:" />
                        <TextBox
                            x:Name="dbNumberInput"
                            Width="60"
                            Padding="5"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Text="1" />
                    </StackPanel>
                    <ui:Button
                        x:Name="btnReadDb"
                        Grid.Column="4"
                        Margin="4,0"
                        Appearance="Success"
                        Click="OnReadDb">
                        读取 DB
                    </ui:Button>
                    <ui:Button
                        Grid.Column="6"
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Click="OnClearDb">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                        清除
                    </ui:Button>
                </Grid>

                <!--  DB 信息 + UDT 提示  -->
                <ui:TextBlock
                    x:Name="dbInfoText"
                    Margin="0,8,0,0"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="未导入 DB 文件" />
                <ui:TextBlock
                    x:Name="udtHintText"
                    Margin="0,4,0,0"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="" />
            </StackPanel>
        </Border>

        <!--  ===== 中间：变量列表 =====  -->
        <Border
            MinHeight="300"
            Margin="0,0,0,12"
            Padding="0"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  表头  -->
                <Border
                    Grid.Row="0"
                    Padding="16,10"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DataProcessCol" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ValueCol" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CommentCol" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="偏移量" />
                        <ui:TextBlock
                            Grid.Column="1"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="变量名" />
                        <ui:TextBlock
                            Grid.Column="2"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="数据处理" />
                        <ui:TextBlock
                            Grid.Column="3"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="数据类型" />
                        <ui:TextBlock
                            Grid.Column="4"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="大小" />
                        <ui:TextBlock
                            Grid.Column="5"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="值" />
                        <ui:TextBlock
                            Grid.Column="6"
                            Margin="8,0,0,0"
                            FontTypography="Caption"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="注释" />
                    </Grid>
                </Border>

                <!--  变量列表  -->
                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="500"
                    VerticalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl x:Name="variableList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DbVariableDisplay}">
                                    <Border
                                        Padding="16,8"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DataProcessCol" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ValueCol" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="CommentCol" />
                                            </Grid.ColumnDefinitions>

                                            <!--  偏移量  -->
                                            <ui:TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding OffsetDisplay}" />

                                            <!--  变量名  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <ui:TextBlock FontTypography="Body" FontWeight="SemiBold" Text="{Binding Name}" />
                                                <ui:InfoBadge
                                                    Margin="6,0,0,0"
                                                    Padding="6,0"
                                                    Severity="Informational"
                                                    Style="{DynamicResource ValueInfoBadgeStyle}"
                                                    Value="{Binding UdtName}"
                                                    Visibility="{Binding UdtName, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!--  数据处理  -->
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="0,0,6,0"
                                                Orientation="Horizontal">

                                                <!--  BOOL 操作按钮  -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding BoolVis}">
                                                    <ui:Button
                                                        Margin="0,0,6,0"
                                                        Appearance="Primary"
                                                        Content="按1松0"
                                                        MouseLeave="OnBitPressLeave"
                                                        PreviewMouseLeftButtonDown="OnBitPressDown"
                                                        PreviewMouseLeftButtonUp="OnBitPressUp" />
                                                    <ui:Button
                                                        Appearance="Caution"
                                                        Content="取反"
                                                        PreviewMouseLeftButtonDown="OnBitToggle" />
                                                </StackPanel>

                                                <!--  数值编辑  -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding EditVis}">
                                                    <TextBox
                                                        MinWidth="70"
                                                        Width="Auto"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ui:Button
                                                        Appearance="Success"
                                                        Click="OnValueEdit"
                                                        Content="改动" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!--  数据类型  -->
                                            <ui:TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DataType}" />

                                            <!--  大小  -->
                                            <ui:TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Size, StringFormat='{}{0}B'}" />

                                            <!--  值  -->
                                            <Border
                                                Grid.Column="5"
                                                Height="28"
                                                Padding="8,3"
                                                MinWidth="60"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TextBoxBackground}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontTypography="Body" 
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Value}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <!--  注释  -->
                                            <ui:TextBlock
                                                Grid.Column="6"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Comment}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!--  空状态  -->
                        <Border
                            x:Name="emptyState"
                            Height="200"
                            Background="Transparent"
                            Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="TitleLarge"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="📄" />
                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontTypography="Body"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="请导入 .db 文件并点击读取" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  ===== 底部状态栏 =====  -->
        <Border
            Padding="16,10"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  连接状态  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse
                        x:Name="connIndicator"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource TextFillColorDisabledBrush}" />
                    <ui:TextBlock
                        x:Name="statusText"
                        Margin="6,0,16,0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="未连接" />
                </StackPanel>

                <!--  DB 大小  -->
                <ui:TextBlock
                    x:Name="dbSizeText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="" />

                <!--  操作信息  -->
                <ui:TextBlock
                    x:Name="operStatusText"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="" />
            </Grid>
        </Border>

    </StackPanel>
</Page>
