<Page
    x:Class="WpfScada.Views.Pages.Plc.AlarmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfScada.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:WpfScada.Models.Plc"
    xmlns:plcc="clr-namespace:WpfScada.Controls.Plc"
    xmlns:services="clr-namespace:WpfScada.Services.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="报警管理"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 严重度颜色转换 -->
        <Style x:Key="SeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 状态标签样式 -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="未确认">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已确认">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已恢复">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已搁置">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid>
        <StackPanel Margin="0,0,0,24">

            <!-- 过滤器 -->
            <plcc:AlarmFilterBar />

            <!-- ============================================================ -->
            <!-- 报警列表 + 右侧滑入详情面板 -->
            <!-- ============================================================ -->
            <Grid Margin="0,16,0,0">

                <!-- 列表面板（全宽） -->
                <Border
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 列头 -->
                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByStatusCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">状态" />
                                        <Run Text="{Binding StatusSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Padding="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByTimeCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">时间" />
                                        <Run Text="{Binding TimeSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortBySeverityCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">级别" />
                                        <Run Text="{Binding SeveritySortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="3"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByVariableCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">变量" />
                                        <Run Text="{Binding VariableSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <ui:TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontTypography="Caption"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="描述" />

                                <Button
                                    Grid.Column="5"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByAreaCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">区域" />
                                        <Run Text="{Binding AreaSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <ui:TextBlock
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    FontTypography="Caption"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="操作" />
                            </Grid>
                        </Border>

                        <!-- 报警项列表 -->
                        <ListBox
                            x:Name="alarmList"
                            Grid.Row="1"
                            MinHeight="300"
                            MaxHeight="600"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredAlarms}"
                            SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.ScrollUnit="Item">
                            <ListBox.Resources>
                                <!-- 行样式：隔行变色 + 闪烁 -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="plc:AlarmItem">
                                    <Border Padding="12,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsFlash}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Setter Property="BorderThickness" Value="4,0,0,0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 状态标签 -->
                                            <Border
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding StatusText}" />
                                            </Border>

                                            <!-- 时间 -->
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"

                                                FontFamily="Consolas"
                                                Text="{Binding TimeText}" />

                                            <!-- 严重度标签 -->
                                            <Border
                                                Grid.Column="2"
                                                Width="88"
                                                Height="24"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SeverityBadgeStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding Severity}" />
                                            </Border>

                                            <!-- 变量名 -->
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"

                                                FontWeight="Medium"
                                                FontFamily="Consolas"
                                                Text="{Binding VariableName}" />

                                            <!-- 描述 -->
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"

                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 区域 -->
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"

                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Area}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                                <ui:Button
                                                    Width="40"
                                                    Height="22"
                                                    Padding="2"
                                                    Margin="0,0,4,0"
                                                    Click="OnOpenConfirmFlyout"
                                                    Content="确认"
                                                    IsEnabled="{Binding IsAcknowledged, Converter={StaticResource InverseBoolConverter}}" />
                                                <ui:Flyout
                                                    IsOpen="{Binding IsConfirmFlyoutOpen}"
                                                    Placement="Bottom">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="0,0,0,6"
                                                            FontWeight="SemiBold"
                                                            Text="确认此报警？" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <ui:Button
                                                                Margin="0,0,6,0"
                                                                Click="OnCloseConfirmFlyout"
                                                                Content="取消" />
                                                            <ui:Button
                                                                Appearance="Primary"
                                                                Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Content="确定" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:Flyout>

                                                <ui:Button
                                                    Width="40"
                                                    Height="22"
                                                    Padding="2"
                                                    Click="OnOpenShelveFlyout"
                                                    Content="搁置"
                                                    IsEnabled="{Binding IsShelved, Converter={StaticResource InverseBoolConverter}}" />
                                                <ui:Flyout
                                                    IsOpen="{Binding IsShelveFlyoutOpen}"
                                                    Placement="Bottom">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="0,0,0,6"
                                                            FontWeight="SemiBold"
                                                            Text="搁置 30 分钟？" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <ui:Button
                                                                Margin="0,0,6,0"
                                                                Click="OnCloseShelveFlyout"
                                                                Content="取消" />
                                                            <ui:Button
                                                                Appearance="Primary"
                                                                Command="{Binding DataContext.ShelveAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Content="确定" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:Flyout>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>
            </Grid>

            <!-- 状态条 -->
            <plcc:StatusStrip
                Margin="0,8,0,0"
                ConnectionQuality="Info"
                ConnectionText="{Binding StatusText}"
                PollingText="-" />
        </StackPanel>

    <!-- 覆盖层 -->
    <plcc:AlarmDetailPanel />
</Grid>
</Page>
