<Page
    x:Class="WpfScada.Views.Pages.Plc.ModbusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfScada.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:WpfScada.ViewModels.Pages.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Modbus 调试"
    Width="Auto"
    MinWidth="800"
    controls:PageControlDocumentation.Show="False"
    d:DataContext="{d:DesignInstance plc:ModbusViewModel,
                                     IsDesignTimeCreatable=False}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.HorizontalScrollBarVisibility="Auto"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============================================================  -->
        <!--  Left Panel  -->
        <!--  ============================================================  -->
        <StackPanel Grid.Column="0">

            <!--  ===== 连接配置 =====  -->
            <Border
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,24"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="连接配置" />
                    </Grid>

                    <!--  协议切换  -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            Grid.Column="0"
                            Content="TCP"
                            GroupName="modbusMode"
                            IsChecked="{Binding IsTcpMode}" />
                        <RadioButton
                            Grid.Column="1"
                            Content="RTU (串口)"
                            GroupName="modbusMode"
                            IsChecked="{Binding IsTcpMode, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>
                    <!--  TCP 参数  -->
                    <StackPanel Visibility="{Binding IsTcpMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="IP 地址" />
                                <ui:TextBox PlaceholderText="192.168.0.1" Text="{Binding TcpIp}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="端口" />
                                <ui:NumberBox
                                    Maximum="65535"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding TcpPort}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  串口参数  -->
                    <StackPanel Visibility="{Binding IsTcpMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="串口" />
                                <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SerialPortName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="波特率" />
                                <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="校验位" />
                                <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding ParityStr}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="停止位" />
                                <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBitsStr}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  连接/断开按钮  -->
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Success"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PlugConnected24" />
                            </ui:Button.Icon>
                            连接
                        </ui:Button>
                        <ui:Button
                            Appearance="Danger"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsConnected}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PlugDisconnected24" />
                            </ui:Button.Icon>
                            断开
                        </ui:Button>
                    </StackPanel>

                    <!--  连接状态  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="8,4"
                        Background="{DynamicResource ControlFillColorInputActiveBrush}"
                        CornerRadius="4">
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ConnectionStatus}" />
                    </Border>
                </StackPanel>
            </Border>

            <!--  ===== 请求参数 =====  -->
            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,24"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="请求参数" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="站号" />
                            <ui:NumberBox
                                Maximum="247"
                                Minimum="1"
                                Value="{Binding DeviceAddr}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="功能码" />
                            <ComboBox
                                x:Name="funcCodeCombo"
                                SelectedIndex="1"
                                SelectionChanged="OnFuncCodeChanged">
                                <ComboBoxItem Tag="1">01 读线圈</ComboBoxItem>
                                <ComboBoxItem Tag="3">03 读保持寄存器</ComboBoxItem>
                                <ComboBoxItem Tag="4">04 读输入寄存器</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="起始地址" />
                            <ui:TextBox PlaceholderText="0" Text="{Binding StartAddr, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="读取数量" />
                            <ui:NumberBox
                                Maximum="125"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding ReadCount}" />
                        </StackPanel>
                    </Grid>

                    <ui:Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SendRequestCommand}"
                        IsEnabled="{Binding IsConnected}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Send24" />
                        </ui:Button.Icon>
                        发送请求
                    </ui:Button>

                    <!--  发送帧显示  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="8,6"
                        Background="{DynamicResource TextBoxBackground}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="发送帧" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding HexSendFrame}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,24"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="状态" />
                    </Grid>
                    <ui:TextBlock
                        FontTypography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </Border>

        </StackPanel>

        <!--  ============================================================  -->
        <!--  Divider  -->
        <!--  ============================================================  -->

        <!--  ============================================================  -->
        <!--  Right Panel: Polling + Response  -->
        <!--  ============================================================  -->
        <StackPanel Grid.Column="2">

            <!--  ===== 定时轮询 =====  -->
            <Border
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="定时轮询(ms)" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:NumberBox
                                MinWidth="100"
                                Maximum="60000"
                                Minimum="100"
                                SpinButtonPlacementMode="Hidden"
                                Value="{Binding PollIntervalMs}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="2"
                            Height="36"
                            Margin="0,0,8,0"
                            VerticalAlignment="Bottom"
                            Appearance="Success"
                            Command="{Binding StartPollingCommand}"
                            IsEnabled="{Binding IsConnected}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </ui:Button.Icon>
                            启动
                        </ui:Button>
                        <ui:Button
                            Grid.Column="3"
                            Height="36"
                            VerticalAlignment="Bottom"
                            Appearance="Danger"
                            Command="{Binding StopPollingCommand}"
                            IsEnabled="{Binding IsPolling}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Stop24" />
                            </ui:Button.Icon>
                            停止
                        </ui:Button>
                    </Grid>

                    <ui:TextBlock
                        Margin="0,6,0,0"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding PollStatsText}" />
                </StackPanel>
            </Border>

            <!--  ===== 响应帧 =====  -->
            <Border
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,24"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="响应" />
                    </Grid>

                    <!--  原始十六进制  -->
                    <Border
                        Padding="12,8"
                        Background="{DynamicResource TextBoxBackground}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="原始十六进制" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding HexResponseFrame}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  解析概要  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="12,8"
                        Background="{DynamicResource TextBoxBackground}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding ResponseRawText, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="解析信息" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding ResponseRawText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ===== 寄存器表格 =====  -->
            <Border
                Margin="0,12,0,0"
                Padding="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding Registers.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  表头  -->
                    <Border
                        Grid.Row="0"
                        Padding="16,10"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock
                                Grid.Column="0"
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="地址" />
                            <ui:TextBlock
                                Grid.Column="1"
                                Margin="0,0,0,24"
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="DEC" />
                            <ui:TextBlock
                                Grid.Column="2"
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="HEX" />
                            <ui:TextBlock
                                Grid.Column="3"
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="BIN" />
                            <ui:TextBlock
                                Grid.Column="4"
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="OCT" />
                            <ui:TextBlock
                                Grid.Column="5"
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="有符号" />
                        </Grid>
                    </Border>

                    <!--  数据行  -->
                    <ListBox
                        Grid.Row="1"
                        MaxHeight="400"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Registers}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16,6"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="0,0,0,0.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Text="{Binding Index, StringFormat=#{0}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,0,24"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontWeight="SemiBold"
                                            Text="{Binding ValueDec}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ValueHex}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ValueBin}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ValueOct}" />
                                        <TextBlock
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Text="{Binding ValueSigned}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
