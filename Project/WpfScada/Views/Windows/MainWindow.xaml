<ui:FluentWindow
    x:Class="WpfScada.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfScada.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
    xmlns:local="clr-namespace:WpfScada.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:WpfScada.Controls.Plc"
    xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1450"
    Height="802"
    MinWidth="900"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    SizeChanged="MainWindow_OnSizeChanged"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <ui:NavigationView
            x:Name="NavigationView"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            EnableDebugMessages="True"
            FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
            FrameMargin="0"
            IsBackButtonVisible="Visible"
            IsFooterSeparatorVisible="False"
            IsPaneToggleVisible="True"
            IsTopSeparatorVisible="False"
            ItemTemplate="{StaticResource LeftCompactNavigationViewItemTemplate}"
            MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
            OpenPaneLength="310"
            PaneClosed="NavigationView_OnPaneClosed"
            PaneDisplayMode="Left"
            PaneOpened="NavigationView_OnPaneOpened"
            SelectionChanged="OnNavigationSelectionChanged"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.Header>
                <StackPanel Margin="42,32,42,20">
                    <ui:BreadcrumbBar x:Name="BreadcrumbBar" />
                    <controls:PageControlDocumentation Margin="0,10,0,0" NavigationView="{Binding ElementName=NavigationView}" />
                </StackPanel>
            </ui:NavigationView.Header>
            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox
                    x:Name="AutoSuggestBox"
                    AutomationProperties.AutomationId="NavigationAutoSuggestBox"
                    PlaceholderText="{i18n:StringLocalizer 'Search'}">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </ui:NavigationView.AutoSuggestBox>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
            <ui:NavigationView.PaneFooter>
                <Rectangle Height="4" Fill="Transparent" />
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui.png" />
            </ui:TitleBar.Icon>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <!--  连接  -->
                    <ui:Button
                        Height="26"
                        Appearance="Primary"
                        Command="{Binding PlcViewModel.ConnectCommand}"
                        FontSize="12"
                        Icon="{ui:SymbolIcon PlugDisconnected24}"
                        IsEnabled="{Binding PlcViewModel.IsConnected, Converter={StaticResource InverseBoolConverter}}"
                        ToolTip="连接到 PLC"
                        ToolTipService.ShowOnDisabled="True" />
                    <!--  断开  -->
                    <ui:Button
                        Height="26"
                        Margin="4,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding PlcViewModel.DisconnectCommand}"
                        FontSize="12"
                        Icon="{ui:SymbolIcon PlugConnected24}"
                        IsEnabled="{Binding PlcViewModel.IsConnected}"
                        ToolTip="断开 PLC 连接"
                        ToolTipService.ShowOnDisabled="True" />
                    <!--  启动  -->
                    <ui:Button
                        Height="26"
                        Margin="4,0,0,0"
                        Appearance="Success"
                        Command="{Binding PlcViewModel.StartPollingCommand}"
                        FontSize="12"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding PlcViewModel.IsConnected}"
                        ToolTip="开始轮询"
                        ToolTipService.ShowOnDisabled="True" />
                    <!--  停止  -->
                    <ui:Button
                        Height="26"
                        Margin="4,0,12,0"
                        Appearance="Danger"
                        Command="{Binding PlcViewModel.StopPollingCommand}"
                        FontSize="12"
                        Icon="{ui:SymbolIcon Stop24}"
                        IsEnabled="{Binding PlcViewModel.Store.IsRunning}"
                        ToolTip="停止轮询"
                        ToolTipService.ShowOnDisabled="True" />

                    <!--  延迟  -->
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="延迟:" />
                    <ui:TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{Binding PlcViewModel.LatencyColor}"
                        Text="{Binding PlcViewModel.LatencyText}" />

                    <!--  LED 指示灯  -->
                    <plc:LedIndicator
                        Width="10"
                        Height="10"
                        Margin="6,2,0,0"
                        VerticalAlignment="Center"
                        Quality="{Binding PlcViewModel.Store.Quality}" />

                    <!--  与主题按钮之间的分隔  -->
                    <Rectangle
                        Width="1"
                        Height="18"
                        Margin="12,0"
                        Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <ui:Button
                        Width="44"
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnThemeToggle"
                        Cursor="Hand"
                        Focusable="False"
                        FontSize="16"
                        ToolTip="切换深浅主题">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Setter Property="Icon">
                                    <Setter.Value>
                                        <ui:SymbolIcon Symbol="WeatherSunny24" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ApplicationTheme, ElementName=TitleBar}" Value="Dark">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <ui:SymbolIcon Symbol="WeatherMoon24" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <tray:NotifyIcon
            Grid.Row="0"
            FocusOnLeftClick="True"
            Icon="pack://application:,,,/Assets/wpfui.png"
            MenuOnRightClick="True"
            TooltipText="WPF SCADA">
            <tray:NotifyIcon.Menu>
                <ContextMenu DataContext="{Binding DataContext, Source={x:Reference NavigationView}}" ItemsSource="{Binding ViewModel.TrayMenuItems, Mode=OneWay}" />
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" />
    </Grid>
</ui:FluentWindow>
