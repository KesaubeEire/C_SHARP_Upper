<UserControl x:Class="Wpf.Ui.Gallery.Controls.Plc.BitBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignWidth="36" d:DesignHeight="32">
    <Border Width="36" Height="32" CornerRadius="4" Margin="2"
            BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{Binding IsSet, Converter={StaticResource BgConverter}}"
            MouseDown="OnMouseDown" ToolTip="点击切换" Cursor="Hand">
        <TextBlock Text="{Binding DisplayChar}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   FontWeight="Bold" FontSize="13"/>
    </Border>
</UserControl>
