<UserControl
    x:Class="Wpf.Ui.Gallery.Controls.Plc.AlarmToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <controls:ControlExample
        xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
        Margin="0"
        HeaderText="报警控制">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding SubscribeCommand}"
                    Content="启动监控"
                    IsEnabled="{Binding IsSubscribed, Converter={StaticResource InverseBoolConverter}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:Button.Icon>
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Success" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSubscribed}" Value="True">
                                    <Setter Property="Appearance" Value="Secondary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding UnsubscribeCommand}"
                    Content="停止监控"
                    IsEnabled="{Binding IsSubscribed}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Stop24" />
                    </ui:Button.Icon>
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSubscribed}" Value="True">
                                    <Setter Property="Appearance" Value="Danger" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <Rectangle
                    Width="1"
                    Margin="8,2,12,2"
                    Fill="{DynamicResource ControlElevationBorderBrush}" />

                <ui:Button
                    Margin="0,0,4,0"
                    Appearance="Success"
                    Command="{Binding AcknowledgeAllCommand}"
                    Content="全部确认">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="4,0,4,0"
                    Appearance="Secondary"
                    Command="{Binding ShelveAllCommand}"
                    Content="全部搁置">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </ui:Button.Icon>
                </ui:Button>

                <Rectangle
                    Width="1"
                    Margin="8,2,12,2"
                    Fill="{DynamicResource ControlElevationBorderBrush}" />

                <ui:Button
                    Margin="0,0,4,0"
                    Appearance="Secondary"
                    Command="{Binding ExportCsvCommand}"
                    Content="导出 CSV">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="4,0,0,0"
                    Appearance="Danger"
                    Command="{Binding ClearAllCommand}"
                    Content="清除历史">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Icon>
                </ui:Button>

                <Rectangle
                    Width="1"
                    Margin="8,2,4,2"
                    Fill="{DynamicResource ControlElevationBorderBrush}" />

                <ui:Button
                    Margin="4,0,0,0"
                    Appearance="Info"
                    Command="{Binding ToggleRuleManagerCommand}"
                    Content="规则管理">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
        </Grid>
    </controls:ControlExample>
</UserControl>
