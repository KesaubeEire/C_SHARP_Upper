<UserControl x:Class="Wpf.Ui.Gallery.Controls.Plc.StatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="36"
             x:Name="root">
    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Connection status -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <plc:LedIndicator x:Name="connLed" Width="10" Height="10"
                                   Quality="{Binding ConnectionQuality, ElementName=root}"
                                   VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ConnectionText, ElementName=root, FallbackValue=未连接}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="6,0,16,0"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource ControlElevationBorderBrush}"
                       VerticalAlignment="Stretch" Margin="0,2"/>

            <!-- Polling info -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="轮询:"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PollingText, ElementName=root, FallbackValue=--}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,16,0"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource ControlElevationBorderBrush}"
                       VerticalAlignment="Stretch" Margin="0,2" Visibility="Collapsed"/>

            <!-- Error count -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,0"
                        Visibility="{Binding ShowErrors, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="错误:"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorCount, ElementName=root, FallbackValue=0}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
