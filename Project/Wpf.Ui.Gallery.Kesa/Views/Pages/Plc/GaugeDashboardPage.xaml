<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.GaugeDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="仪表盘"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!-- Section title -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="3"
                        Height="18"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorAttentionBrush}"
                        CornerRadius="2" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontTypography="Subtitle"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="伺服仪表盘" />
                    <ui:TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="4台伺服 · 实时监控" />
                </Grid>
            </Border>

            <!-- Gauge cards: 4-column grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <ui:TextBlock
                            Margin="0,0,0,12"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="伺服 1" />
                        <plc:ServoGauge
                            x:Name="servo1"
                            NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            GreenMax="96" YellowMax="160" RedMax="200" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <ui:TextBlock
                            Margin="0,0,0,12"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="伺服 2" />
                        <plc:ServoGauge
                            x:Name="servo2"
                            NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            GreenMax="108" YellowMax="180" RedMax="200" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <ui:TextBlock
                            Margin="0,0,0,12"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="伺服 3" />
                        <plc:ServoGauge
                            x:Name="servo3"
                            NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            GreenMax="96" YellowMax="160" RedMax="200" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <ui:TextBlock
                            Margin="0,0,0,12"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="伺服 4" />
                        <plc:ServoGauge
                            x:Name="servo4"
                            NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            GreenMax="108" YellowMax="180" RedMax="200" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
