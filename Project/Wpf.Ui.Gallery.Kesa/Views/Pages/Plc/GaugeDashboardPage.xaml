<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.GaugeDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="仪表盘"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="12,0,12,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ===== 伺服 1 =====  -->
            <controls:ControlExample Grid.Column="0" Margin="4" HeaderText="伺服 1">
                <plc:ServoGauge
                    x:Name="servo1"
                    NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    GreenMax="96" YellowMax="160" RedMax="200" />
            </controls:ControlExample>

            <!--  ===== 伺服 2 =====  -->
            <controls:ControlExample Grid.Column="1" Margin="4" HeaderText="伺服 2">
                <plc:ServoGauge
                    x:Name="servo2"
                    NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    GreenMax="108" YellowMax="180" RedMax="200" />
            </controls:ControlExample>

            <!--  ===== 伺服 3 =====  -->
            <controls:ControlExample Grid.Column="2" Margin="4" HeaderText="伺服 3">
                <plc:ServoGauge
                    x:Name="servo3"
                    NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    GreenMax="96" YellowMax="160" RedMax="200" />
            </controls:ControlExample>

            <!--  ===== 伺服 4 =====  -->
            <controls:ControlExample Grid.Column="3" Margin="4" HeaderText="伺服 4">
                <plc:ServoGauge
                    x:Name="servo4"
                    NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    UnitBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    GreenMax="108" YellowMax="180" RedMax="200" />
            </controls:ControlExample>

        </Grid>
    </ScrollViewer>
</Page>
