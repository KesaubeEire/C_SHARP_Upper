<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.GaugeDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="仪表盘"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="12,0,12,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ===== 伺服 1 =====  -->
            <controls:ControlExample Grid.Column="0" Margin="4" HeaderText="伺服 1">
                <Grid>
                    <lvc:PieChart
                        x:Name="servoGauge1"
                        Width="200"
                        Height="230"
                        InitialRotation="-225"
                        MaxAngle="270"
                        MaxValue="200"
                        MinValue="0">
                        <lvc:PieChart.Series>
                            <lvc:SeriesCollection>
                                <lvc:XamlAngularGaugeSeries
                                    x:Name="servo1Green"
                                    CornerRadius="0"
                                    Fill="#4ade80"
                                    GaugeValue="0"
                                    MaxRadialColumnWidth="16"
                                    OuterRadiusOffset="100" />
                                <lvc:XamlAngularGaugeSeries
                                    x:Name="servo1Yellow"
                                    CornerRadius="0"
                                    Fill="#facc15"
                                    GaugeValue="0"
                                    MaxRadialColumnWidth="16"
                                    OuterRadiusOffset="100" />
                                <lvc:XamlAngularGaugeSeries
                                    x:Name="servo1Red"
                                    CornerRadius="0"
                                    Fill="#ef4444"
                                    GaugeValue="0"
                                    MaxRadialColumnWidth="16"
                                    OuterRadiusOffset="100" />
                            </lvc:SeriesCollection>
                        </lvc:PieChart.Series>

                        <lvc:PieChart.VisualElements>
                            <lvc:VisualsCollection>
                                <lvc:XamlNeedle
                                    x:Name="servo1Needle"
                                    Width="16"
                                    Value="0" />
                                <lvc:XamlAngularTicks
                                    x:Name="servo1Ticks"
                                    LabelsOuterOffset="12"
                                    LabelsSize="12"
                                    OuterOffset="50"
                                    TicksLength="14" />
                            </lvc:VisualsCollection>
                        </lvc:PieChart.VisualElements>
                    </lvc:PieChart>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,18">
                        <TextBlock
                            x:Name="servo1Value"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="0.0" />
                        <TextBlock
                            x:Name="servo1Unit"
                            Margin="0,-2,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="mm/s" />
                    </StackPanel>
                </Grid>
            </controls:ControlExample>

