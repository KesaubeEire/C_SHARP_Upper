<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.GaugeDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="仪表盘"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Width="360" Margin="0,0,0,24">

        <!--  ===== 单值仪表 (AngularGauge 带指针) =====  -->
        <controls:ControlExample Margin="0" HeaderText="单值仪表">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    FontTypography="Subtitle"
                    Text="当前值" />

                <!--  AngularGauge: 圆形进度条 + Needle 指针 + 刻度线  -->
                <lvc:PieChart
                    x:Name="singleGauge"
                    Grid.Row="1"
                    Width="280"
                    Height="280"
                    InitialRotation="-225"
                    MaxAngle="270"
                    MaxValue="50"
                    MinValue="0">
                    <lvc:PieChart.Series>
                        <lvc:SeriesCollection>
                            <!--  3 段色  -->
                            <lvc:XamlAngularGaugeSeries
                                x:Name="singleGaugeGreen"
                                CornerRadius="0"
                                Fill="#4ade80"
                                GaugeValue="30"
                                MaxRadialColumnWidth="20"
                                OuterRadiusOffset="130" />
                            <lvc:XamlAngularGaugeSeries
                                x:Name="singleGaugeYellow"
                                CornerRadius="0"
                                Fill="#facc15"
                                GaugeValue="10"
                                MaxRadialColumnWidth="20"
                                OuterRadiusOffset="130" />
                            <lvc:XamlAngularGaugeSeries
                                x:Name="singleGaugeRed"
                                CornerRadius="0"
                                Fill="#ef4444"
                                GaugeValue="10"
                                MaxRadialColumnWidth="20"
                                OuterRadiusOffset="130" />
                        </lvc:SeriesCollection>
                    </lvc:PieChart.Series>

                    <lvc:PieChart.VisualElements>
                        <lvc:VisualsCollection>
                            <!--  指针  -->
                            <lvc:XamlNeedle
                                x:Name="singleNeedle"
                                Width="20"
                                Value="0" />

                            <!--  刻度  -->
                            <lvc:XamlAngularTicks
                                x:Name="singleTicks"
                                LabelsOuterOffset="15"
                                LabelsSize="16"
                                OuterOffset="65"
                                TicksLength="20" />
                        </lvc:VisualsCollection>
                    </lvc:PieChart.VisualElements>
                </lvc:PieChart>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="gaugeValueText"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="0.0" />
                    <TextBlock
                        x:Name="gaugeUnitText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="mm" />
                </StackPanel>
            </Grid>
        </controls:ControlExample>

    </StackPanel>
</Page>
