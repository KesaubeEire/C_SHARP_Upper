<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.AlarmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
    xmlns:plcc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:services="clr-namespace:Wpf.Ui.Gallery.Services.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.Plc"
    Title="报警管理"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 严重度颜色转换 -->
        <Style x:Key="SeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                    <Setter Property="Background" Value="#FFD32F2F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 状态标签样式 -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="未确认">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已确认">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已搁置">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 统计卡样式 -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!-- ============================================================ -->
            <!-- 工具栏 -->
            <!-- ============================================================ -->
            <controls:ControlExample Margin="0" HeaderText="报警控制">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding SubscribeCommand}"
                            Content="▶ 启动监控"
                            
                            IsEnabled="{Binding IsSubscribed, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Command="{Binding UnsubscribeCommand}"
                            Content="■ 停止监控"
                            
                            IsEnabled="{Binding IsSubscribed}" />

                        <Rectangle
                            Width="1"
                            Margin="8,2,12,2"
                            Fill="{DynamicResource ControlElevationBorderBrush}" />

                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Success"
                            Command="{Binding AcknowledgeAllCommand}"
                            Content="全部确认"
                             />
                        <ui:Button
                            Margin="4,0,4,0"
                            Appearance="Secondary"
                            Command="{Binding ShelveAllCommand}"
                            Content="全部搁置"
                             />

                        <Rectangle
                            Width="1"
                            Margin="8,2,12,2"
                            Fill="{DynamicResource ControlElevationBorderBrush}" />

                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Secondary"
                            Command="{Binding ExportCsvCommand}"
                            Content="📥 导出 CSV"
                             />
                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Danger"
                            Command="{Binding ClearAllCommand}"
                            Content="清除历史"
                             />

                        <Rectangle
                            Width="1"
                            Margin="8,2,4,2"
                            Fill="{DynamicResource ControlElevationBorderBrush}" />

                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Info"
                            Command="{Binding ToggleRuleManagerCommand}"
                            Content="⚙ 规则管理"
                             />
                    </WrapPanel>
                </Grid>
            </controls:ControlExample>

            <!-- ============================================================ -->
            <!-- 统计条 -->
            <!-- ============================================================ -->
            <Border
                Margin="0,8,0,0"
                Padding="16,12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 活动报警 -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" BorderBrush="#FFD32F2F">
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="活动报警" />
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#FFD32F2F"
                                Text="{Binding ActiveCount}" />
                        </StackPanel>
                    </Border>

                    <Rectangle
                        Grid.Column="1"
                        Width="1"
                        Margin="12,4"
                        Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <!-- 未确认 -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="未确认" />
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{Binding UnacknowledgedCount}" />
                        </StackPanel>
                    </Border>

                    <Rectangle
                        Grid.Column="3"
                        Width="1"
                        Margin="12,4"
                        Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <!-- 今日 -->
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="今日报警" />
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding TodayCount}" />
                        </StackPanel>
                    </Border>

                    <Rectangle
                        Grid.Column="5"
                        Width="1"
                        Margin="12,4"
                        Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <!-- 搁置 + 紧急/严重 -->
                    <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="搁置" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ShelvedCount}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="本时" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ThisHourCount}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="紧急" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#FFD32F2F"
                                    Text="{Binding EmergencyCount}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="严重" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="{Binding CriticalCount}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 刷新按钮 -->
                    <ui:Button
                        Grid.Column="7"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        Appearance="Secondary"
                        Command="{Binding RefreshStatisticsCommand}"
                        Content="⟳ 刷新统计"
                        FontSize="14"/>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 规则管理面板 -->
            <!-- ============================================================ -->
            <Border
                Margin="0,8,0,0"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsRuleManagerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="报警规则管理" />
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Primary"
                            Command="{Binding AddNewRuleCommand}"
                            Content="＋ 添加规则"
                            FontSize="12" />
                    </Grid>

                    <!-- 规则列表 -->
                    <Border
                        Margin="0,12,0,0"
                        MaxHeight="240"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Rules}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="services:AlarmRule">
                                    <Border
                                        Padding="8,6"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                        BorderThickness="0,0,0,0.5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                Text="{Binding VariableKey}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DataType}" />

                                            <Border
                                                Grid.Column="2"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                                                                <Setter Property="Background" Value="#FFD32F2F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding Severity}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ConditionType}" />

                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Threshold}" />

                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Deadband, StringFormat={}{0:F1}}" />

                                            <TextBlock
                                                Grid.Column="6"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Area}" />

                                            <CheckBox
                                                Grid.Column="7"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsEnabled}"
                                                IsEnabled="False" />

                                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                                                <Button
                                                    Width="36"
                                                    Height="20"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Content="编辑"
                                                    FontSize="9" />
                                                <Button
                                                    Width="36"
                                                    Height="20"
                                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Content="删除"
                                                    FontSize="9" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 编辑/添加表单 -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsEditingRule, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="添加新规则" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="变量名 *" />
                                    <ui:TextBox PlaceholderText="I0, Q5, M10, DB1:6..." Text="{Binding EditVariableKey}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="数据类型" />
                                    <ComboBox
                                        ItemsSource="{Binding EditDataTypeOptions}"
                                        SelectedItem="{Binding EditDataType}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="级别" />
                                    <ComboBox
                                        ItemsSource="{Binding EditSeverityOptions}"
                                        SelectedItem="{Binding EditSeverity}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="报警类型" />
                                    <ComboBox
                                        ItemsSource="{Binding EditConditionTypeOptions}"
                                        SelectedItem="{Binding EditConditionType}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="阈值" />
                                    <ui:NumberBox
                                        Maximum="99999"
                                        Minimum="-99999"
                                        Value="{Binding EditThreshold}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,8,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="死区" />
                                    <ui:NumberBox
                                        Maximum="99999"
                                        Minimum="0"
                                        Value="{Binding EditDeadband}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,8,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="触发延时(ms)" />
                                    <ui:NumberBox
                                        Maximum="60000"
                                        Minimum="0"
                                        Value="{Binding EditOnDelayMs}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,8,0,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="恢复延时(ms)" />
                                    <ui:NumberBox
                                        Maximum="60000"
                                        Minimum="0"
                                        Value="{Binding EditOffDelayMs}" />
                                </StackPanel>

                                <!-- 第三行：区域 + 启用 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="描述" />
                                    <ui:TextBox PlaceholderText="例如：温度高限报警" Text="{Binding EditDescription}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,8,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="区域" />
                                    <ui:TextBox PlaceholderText="反应釜A、蒸馏塔..." Text="{Binding EditArea}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="4,8,8,0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="启用" />
                                    <CheckBox
                                        Margin="0,4,0,0"
                                        IsChecked="{Binding EditIsEnabled}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Primary"
                                    Command="{Binding SaveRuleCommand}"
                                    Content="保存规则"
                                    FontSize="12" />
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding CancelEditRuleCommand}"
                                    Content="取消"
                                    FontSize="12" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- 过滤栏 -->
            <!-- ============================================================ -->
            <Border
                Margin="0,8,0,0"
                Padding="12,8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <WrapPanel>
                    <ui:TextBox
                        Width="200"
                        Margin="0,0,8,0"
                        PlaceholderText="搜索变量/描述/区域..."
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        Width="100"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding SeverityOptions}"
                        SelectedItem="{Binding SelectedSeverityOption}" />

                    <ComboBox
                        Width="110"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding AreaOptions}"
                        Text="{Binding FilterArea, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" />

                    <DatePicker
                        Width="120"
                        Margin="0,0,4,0"
                        SelectedDate="{Binding FilterDateFrom}" />
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="~" />
                    <DatePicker
                        Width="120"
                        Margin="0,0,8,0"
                        SelectedDate="{Binding FilterDateTo}" />

                    <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="显示搁置"
                        IsChecked="{Binding ShowShelved}" />

                    <ui:Button
                        Margin="0,0,4,0"
                        Appearance="Primary"
                        Command="{Binding ApplyFilterCommand}"
                        Content="筛选"
                         />
                    <ui:Button
                        Appearance="Secondary"
                        Command="{Binding ResetFilterCommand}"
                        Content="重置"
                         />
                </WrapPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- 报警列表 + 详情面板 -->
            <!-- ============================================================ -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 列表面板 -->
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 列头 -->
                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByTimeCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="时间" />
                                        <Run Text="{Binding TimeSortGlyph}" />
                                    </TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortBySeverityCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="级别" />
                                        <Run Text="{Binding SeveritySortGlyph}" />
                                    </TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByVariableCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="变量" />
                                        <Run Text="{Binding VariableSortGlyph}" />
                                    </TextBlock>
                                </Button>

                                <TextBlock
                                    Grid.Column="3"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="描述" />

                                <Button
                                    Grid.Column="4"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByAreaCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="区域" />
                                        <Run Text="{Binding AreaSortGlyph}" />
                                    </TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="5"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByStatusCommand}"
                                    Cursor="Hand">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="状态" />
                                        <Run Text="{Binding StatusSortGlyph}" />
                                    </TextBlock>
                                </Button>

                                <TextBlock
                                    Grid.Column="6"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="操作" />
                            </Grid>
                        </Border>

                        <!-- 报警项列表 -->
                        <ListBox
                            x:Name="alarmList"
                            Grid.Row="1"
                            MinHeight="300"
                            MaxHeight="600"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredAlarms}"
                            SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.ScrollUnit="Item">
                            <ListBox.Resources>
                                <!-- 行样式：隔行变色 + 闪烁 -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="plc:AlarmItem">
                                    <Border Padding="12,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsFlash}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FFD32F2F" />
                                                        <Setter Property="BorderThickness" Value="4,0,0,0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 时间 -->
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                
                                                FontFamily="Consolas"
                                                Text="{Binding TimeText}" />

                                            <!-- 严重度标签 -->
                                            <Border
                                                Grid.Column="1"
                                                Width="56"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SeverityBadgeStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding Severity}" />
                                            </Border>

                                            <!-- 变量名 -->
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                
                                                FontWeight="Medium"
                                                FontFamily="Consolas"
                                                Text="{Binding VariableName}" />

                                            <!-- 描述 -->
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 区域 -->
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Area}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 状态标签 -->
                                            <Border
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding StatusText}" />
                                            </Border>

                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                                <Button
                                                    Width="40"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Content="确认"
                                                    FontSize="10"
                                                    IsEnabled="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <Button
                                                    Width="40"
                                                    Height="22"
                                                    Command="{Binding DataContext.ShelveAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Content="搁置"
                                                    FontSize="10"
                                                    IsEnabled="{Binding IsShelved, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 详情面板 -->
                <Border
                    Grid.Column="1"
                    Width="280"
                    Margin="12,0,0,0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding SelectedAlarm, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.Resources>
                        <Style TargetType="TextBlock" x:Key="DetailLabel">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Margin" Value="0,8,0,2" />
                        </Style>
                        <Style TargetType="TextBlock" x:Key="DetailValue">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Style>
                    </Border.Resources>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="报警详情" />

                            <Rectangle
                                Height="1"
                                Margin="0,8,0,4"
                                Fill="{DynamicResource ControlElevationBorderBrush}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="描述" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Description}" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="变量" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.VariableName}" FontFamily="Consolas" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource DetailLabel}" Text="当前值" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Text="{Binding SelectedAlarm.CurrentValue, StringFormat=F2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource DetailLabel}" Text="阈值" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding SelectedAlarm.Threshold, StringFormat={}{0:F2}}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource DetailLabel}" Text="报警类型" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.AlarmType}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="严重度" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Severity}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="区域" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Area}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="产生时间" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.DateTimeText}" FontFamily="Consolas" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="状态" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.StatusText}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="死区" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.Deadband, StringFormat=F2}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="确认人" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedAlarm.AcknowledgedBy, TargetNullValue=—}" />

                            <TextBlock Style="{StaticResource DetailLabel}" Text="确认时间" />
                            <TextBlock
                                
                                FontFamily="Consolas"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SelectedAlarm.AcknowledgedAt, TargetNullValue=—}" />

                            <!-- 备注编辑 -->
                            <TextBlock Style="{StaticResource DetailLabel}" Text="操作员备注" />
                            <TextBox
                                Margin="0,2,0,4"
                                AcceptsReturn="True"
                                MaxLines="3"
                                Text="{Binding SelectedAlarm.Comment, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Margin="0,0,0,8"
                                Appearance="Primary"
                                Command="{Binding SaveCommentCommand}"
                                Content="保存备注"
                                 />

                            <!-- 搁置操作 -->
                            <Rectangle
                                Height="1"
                                Margin="0,4"
                                Fill="{DynamicResource ControlElevationBorderBrush}" />
                            <TextBlock
                                Margin="0,4,0,4"
                                
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="搁置操作" />
                            <WrapPanel>
                                <Button
                                    Width="50"
                                    Height="24"
                                    Margin="0,0,4,4"
                                    Command="{Binding ShelveAlarm1HCommand}"
                                    CommandParameter="{Binding SelectedAlarm}"
                                    Content="1 小时"
                                    FontSize="10" />
                                <Button
                                    Width="50"
                                    Height="24"
                                    Margin="0,0,4,4"
                                    Command="{Binding ShelveAlarm8HCommand}"
                                    CommandParameter="{Binding SelectedAlarm}"
                                    Content="8 小时"
                                    FontSize="10" />
                                <Button
                                    Width="50"
                                    Height="24"
                                    Margin="0,0,4,4"
                                    Command="{Binding ShelveAlarm24HCommand}"
                                    CommandParameter="{Binding SelectedAlarm}"
                                    Content="24 小时"
                                    FontSize="10" />
                                <Button
                                    Width="50"
                                    Height="24"
                                    Margin="0,0,0,4"
                                    Command="{Binding UnshelveAlarmCommand}"
                                    CommandParameter="{Binding SelectedAlarm}"
                                    Content="取消"
                                    FontSize="10" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 状态条 -->
            <plcc:StatusStrip
                Grid.Row="3"
                Margin="0,8,0,0"
                ConnectionQuality="Info"
                ConnectionText="{Binding StatusText}"
                PollingText="-" />
        </StackPanel>
    </ScrollViewer>
</Page>
