<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.AlarmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
    xmlns:plcc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:services="clr-namespace:Wpf.Ui.Gallery.Services.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="报警管理"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 严重度颜色转换 -->
        <Style x:Key="SeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 状态标签样式 -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="未确认">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已确认">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已恢复">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已搁置">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!-- 工具栏 -->
            <plcc:AlarmToolbar />

            <!-- 统计条 -->
            <plcc:AlarmStatCards />

            <!-- ============================================================ -->
            <!-- 规则管理面板 — Vercel 风格 -->
            <!-- ============================================================ -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsRuleManagerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <!-- 头部：标题 + 添加按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="规则管理" />
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Primary"
                            Command="{Binding AddNewRuleCommand}"
                            Content="添加规则">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <!-- 规则列表 -->
                    <Border
                        MinHeight="80"
                        MaxHeight="280"
                         Margin="0,10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Rules}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="services:AlarmRule">
                                <Border
                                    Padding="12,8"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="0,0,0,0.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Variable + DataType -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontTypography="BodyStrong"
                                                FontFamily="Consolas"
                                                Text="{Binding VariableKey}" />
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorInputActiveBrush}"
                                                CornerRadius="3">
                                                <ui:TextBlock
                                                    FontTypography="Caption"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DataType}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Severity 彩色药丸 -->
                                        <Border
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Height="20"
                                            Padding="8,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                TextAlignment="Center"
                                                FontTypography="Caption"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{Binding Severity}" />
                                        </Border>

                                        <!-- ConditionType -->
                                        <ui:TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontTypography="Body"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ConditionType}" />

                                        <!-- Description (主要列) -->
                                        <ui:TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontTypography="Body"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- Threshold + Deadband -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontTypography="Body"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Threshold, StringFormat={}{0:0.##}}" />
                                            <ui:TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Deadband, StringFormat=±{0:0.#}}" />
                                        </StackPanel>

                                        <!-- Area -->
                                        <ui:TextBlock
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Area}" />

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                                            <ui:Button
                                                Appearance="Info"
                                                Margin="0,0,4,0"
                                                Padding="4,0"
                                                Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="编辑"
                                                ToolTip="编辑此规则" />
                                            <ui:Button
                                                Appearance="Danger"
                                                Padding="4,0"
                                                Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="删除"
                                                ToolTip="删除此规则" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 编辑/添加表单 -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsEditingRule, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="3"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SystemFillColorAttentionBrush}"
                                    CornerRadius="2" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="规则设置" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 第一行：变量名 / 数据类型 / 级别 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="变量名 *" />
                                    <ui:TextBox PlaceholderText="I0, Q5, M10, DB1:6..." Text="{Binding EditVariableKey}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="数据类型" />
                                    <ComboBox
                                        ItemsSource="{Binding EditDataTypeOptions}"
                                        SelectedItem="{Binding EditDataType}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,0,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="级别" />
                                    <ComboBox
                                        ItemsSource="{Binding EditSeverityOptions}"
                                        SelectedItem="{Binding EditSeverity}" />
                                </StackPanel>

                                <!-- 第二行：报警类型 / 阈值 / 死区 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="报警类型" />
                                    <ComboBox
                                        ItemsSource="{Binding EditConditionTypeOptions}"
                                        SelectedItem="{Binding EditConditionType}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,8,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="阈值" />
                                    <ui:NumberBox
                                        Maximum="99999"
                                        Minimum="-99999"
                                        Value="{Binding EditThreshold}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,8,0,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="死区" />
                                    <ui:NumberBox
                                        Maximum="99999"
                                        Minimum="0"
                                        Value="{Binding EditDeadband}" />
                                </StackPanel>

                                <!-- 第三行：触发延时 / 恢复延时 / 区域 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="触发延时 (ms)" />
                                    <ui:NumberBox
                                        Maximum="60000"
                                        Minimum="0"
                                        Value="{Binding EditOnDelayMs}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,8,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="恢复延时 (ms)" />
                                    <ui:NumberBox
                                        Maximum="60000"
                                        Minimum="0"
                                        Value="{Binding EditOffDelayMs}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="4,8,0,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="区域" />
                                    <ui:TextBox PlaceholderText="反应釜A、蒸馏塔..." Text="{Binding EditArea}" />
                                </StackPanel>

                                <!-- 第四行：描述 + 启用 + 操作 -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,8,8,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="描述" />
                                    <ui:TextBox PlaceholderText="例如：温度高限报警" Text="{Binding EditDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="4,8,0,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="启用" />
                                    <CheckBox
                                        Margin="0,6,0,0"
                                        IsChecked="{Binding EditIsEnabled}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="4,8,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Appearance="Primary"
                                        Command="{Binding SaveRuleCommand}"
                                        Content="保存" />
                                    <ui:Button
                                        Appearance="Secondary"
                                        Command="{Binding CancelEditRuleCommand}"
                                        Content="取消" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 过滤栏 -->
            <plcc:AlarmFilterBar />

            <!-- ============================================================ -->
            <!-- 报警列表 + 右侧滑入详情面板 -->
            <!-- ============================================================ -->
            <Grid Margin="0,16,0,0">

                <!-- 列表面板（全宽） -->
                <Border
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 列头 -->
                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByStatusCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">状态" />
                                        <Run Text="{Binding StatusSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Padding="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByTimeCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">时间" />
                                        <Run Text="{Binding TimeSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortBySeverityCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">级别" />
                                        <Run Text="{Binding SeveritySortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <Button
                                    Grid.Column="3"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByVariableCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">变量" />
                                        <Run Text="{Binding VariableSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <ui:TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontTypography="Caption"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="描述" />

                                <Button
                                    Grid.Column="5"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SortByAreaCommand}"
                                    Cursor="Hand">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text=">区域" />
                                        <Run Text="{Binding AreaSortGlyph}" />
                                    </ui:TextBlock>
                                </Button>

                                <ui:TextBlock
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    FontTypography="Caption"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="操作" />
                            </Grid>
                        </Border>

                        <!-- 报警项列表 -->
                        <ListBox
                            x:Name="alarmList"
                            Grid.Row="1"
                            MinHeight="300"
                            MaxHeight="600"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredAlarms}"
                            SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.ScrollUnit="Item">
                            <ListBox.Resources>
                                <!-- 行样式：隔行变色 + 闪烁 -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="plc:AlarmItem">
                                    <Border Padding="12,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsFlash}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Setter Property="BorderThickness" Value="4,0,0,0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 状态标签 -->
                                            <Border
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding StatusText}" />
                                            </Border>

                                            <!-- 时间 -->
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"

                                                FontFamily="Consolas"
                                                Text="{Binding TimeText}" />

                                            <!-- 严重度标签 -->
                                            <Border
                                                Grid.Column="2"
                                                Width="88"
                                                Height="24"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SeverityBadgeStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding Severity}" />
                                            </Border>

                                            <!-- 变量名 -->
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"

                                                FontWeight="Medium"
                                                FontFamily="Consolas"
                                                Text="{Binding VariableName}" />

                                            <!-- 描述 -->
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"

                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 区域 -->
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"

                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Area}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                                <ui:Button
                                                    Width="40"
                                                    Height="22"
                                                    Padding="2"
                                                    Margin="0,0,4,0"
                                                    Click="OnOpenConfirmFlyout"
                                                    Content="确认"
                                                    IsEnabled="{Binding IsAcknowledged, Converter={StaticResource InverseBoolConverter}}" />
                                                <ui:Flyout
                                                    IsOpen="{Binding IsConfirmFlyoutOpen}"
                                                    Placement="Bottom">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="0,0,0,6"
                                                            FontWeight="SemiBold"
                                                            Text="确认此报警？" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <ui:Button
                                                                Margin="0,0,6,0"
                                                                Click="OnCloseConfirmFlyout"
                                                                Content="取消" />
                                                            <ui:Button
                                                                Appearance="Primary"
                                                                Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Content="确定" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:Flyout>

                                                <ui:Button
                                                    Width="40"
                                                    Height="22"
                                                    Padding="2"
                                                    Click="OnOpenShelveFlyout"
                                                    Content="搁置"
                                                    IsEnabled="{Binding IsShelved, Converter={StaticResource InverseBoolConverter}}" />
                                                <ui:Flyout
                                                    IsOpen="{Binding IsShelveFlyoutOpen}"
                                                    Placement="Bottom">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="0,0,0,6"
                                                            FontWeight="SemiBold"
                                                            Text="搁置 30 分钟？" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <ui:Button
                                                                Margin="0,0,6,0"
                                                                Click="OnCloseShelveFlyout"
                                                                Content="取消" />
                                                            <ui:Button
                                                                Appearance="Primary"
                                                                Command="{Binding DataContext.ShelveAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Content="确定" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:Flyout>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>
            </Grid>

            <!-- 状态条 -->
            <plcc:StatusStrip
                Margin="0,8,0,0"
                ConnectionQuality="Info"
                ConnectionText="{Binding StatusText}"
                PollingText="-" />
        </StackPanel>
    </ScrollViewer>

    <!-- 覆盖层 -->
    <plcc:AlarmDetailPanel />
</Grid>
</Page>
