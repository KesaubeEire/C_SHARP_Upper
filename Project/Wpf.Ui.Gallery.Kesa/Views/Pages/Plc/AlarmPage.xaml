<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.AlarmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
      xmlns:plcc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="报警管理"
      d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,8">
            <ui:TextBlock FontTypography="Title" Text="报警管理" />
            <TextBlock Text="实时报警监控与历史报警查询"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16"
                Margin="24,8,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="▶ 启动监控"
                           Appearance="Primary"
                           Command="{Binding SubscribeCommand}"
                           IsEnabled="{Binding IsSubscribed, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                           Margin="0,0,8,0"/>
                <ui:Button Grid.Column="1" Content="■ 停止监控"
                           Appearance="Secondary"
                           Command="{Binding UnsubscribeCommand}"
                           IsEnabled="{Binding IsSubscribed}"
                           Margin="0,0,8,0"/>

                <Rectangle Grid.Column="2" Width="1"
                           Fill="{DynamicResource ControlElevationBorderBrush}"
                           Margin="8,2,12,2"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="报警:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding ActiveCount, FallbackValue=0}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="4,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="总计:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount, FallbackValue=0}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <ui:Button Grid.Column="4" Content="全部确认"
                           Appearance="Secondary"
                           Command="{Binding AcknowledgeAllCommand}"
                           Margin="8,0,4,0" FontSize="12"/>
                <ui:Button Grid.Column="5" Content="清除"
                           Appearance="Secondary"
                           Command="{Binding ClearAllCommand}"
                           Margin="4,0,0,0" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Alarm List -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="0"
                Margin="24,0,24,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="级别" FontWeight="Bold" FontSize="11" Width="60"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="变量" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="描述" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="状态" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="5" Text="操作" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Alarm items -->
                <ListBox Grid.Row="1" x:Name="alarmList"
                         ItemsSource="{Binding FilteredAlarms}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="plc:AlarmItem">
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                               FontSize="12" VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" CornerRadius="3" Width="60" Height="20"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3498DB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Background" Value="#F39C12"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Background" Value="#E67E22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Severity}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding VariableName}"
                                               FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Description}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="4" CornerRadius="3" Padding="6,2"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="#27AE60"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="未确认">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="已确认">
                                                        <Setter Property="Background" Value="#F39C12"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10" FontWeight="Medium"
                                                   Foreground="White"/>
                                    </Border>

                                    <Button Grid.Column="5" Content="确认"
                                            FontSize="11" Height="24" Width="50"
                                            Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status bar -->
        <plcc:StatusStrip Grid.Row="3"
                          ConnectionText="{Binding StatusText}"
                          ConnectionQuality="Info"
                          PollingText="-"
                          Margin="24,0,24,16"/>
    </Grid>
</Page>
