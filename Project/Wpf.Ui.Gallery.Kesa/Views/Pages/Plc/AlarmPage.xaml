<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.AlarmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
    xmlns:plcc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="报警管理"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="报警工具栏">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Command="{Binding SubscribeCommand}"
                        Content="▶ 启动监控"
                        IsEnabled="{Binding IsSubscribed, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding UnsubscribeCommand}"
                        Content="■ 停止监控"
                        IsEnabled="{Binding IsSubscribed}" />

                    <Rectangle
                        Grid.Column="2"
                        Width="1"
                        Margin="8,2,12,2"
                        Fill="{DynamicResource ControlElevationBorderBrush}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="报警:" />
                        <TextBlock
                            Margin="4,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ActiveCount, FallbackValue=0}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="总计:" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding TotalCount, FallbackValue=0}" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="4"
                        Margin="8,0,4,0"
                        Appearance="Secondary"
                        Command="{Binding AcknowledgeAllCommand}"
                        Content="全部确认"
                        FontSize="12" />
                    <ui:Button
                        Grid.Column="5"
                        Margin="4,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ClearAllCommand}"
                        Content="清除"
                        FontSize="12" />
                </Grid>
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,32,0,0" HeaderText="报警列表">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Column headers  -->
                    <Border
                        Grid.Row="0"
                        Padding="12,8"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="时间" />
                            <TextBlock
                                Grid.Column="1"
                                Width="60"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="级别" />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="变量" />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="描述" />
                            <TextBlock
                                Grid.Column="4"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="状态" />
                            <TextBlock
                                Grid.Column="5"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="操作" />
                        </Grid>
                    </Border>

                    <!--  Alarm items  -->
                    <ListBox
                        x:Name="alarmList"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding FilteredAlarms}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="plc:AlarmItem">
                                <Border
                                    Padding="12,8"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding TimeText}" />

                                        <Border
                                            Grid.Column="1"
                                            Width="60"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{Binding Severity}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Text="{Binding VariableName}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis" />

                                        <Border
                                            Grid.Column="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="未确认">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="已确认">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{Binding StatusText}" />
                                        </Border>

                                        <Button
                                            Grid.Column="5"
                                            Width="50"
                                            Height="24"
                                            Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Content="确认"
                                            FontSize="11"
                                            IsEnabled="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </controls:ControlExample>

        <!--  Status bar  -->
        <plcc:StatusStrip
            Grid.Row="3"
            Margin="0,8,0,0"
            ConnectionQuality="Info"
            ConnectionText="{Binding StatusText}"
            PollingText="-" />
    </StackPanel>
</Page>
