<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.TrendChartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="趋势图"
      mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Margin="0,0,0,12" FontTypography="Title" Text="实时趋势图" />

        <controls:ControlExample Margin="0" HeaderText="图表控件">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="timeRangeCombo" SelectedIndex="0" Width="120" Margin="0,0,8,0">
                            <ComboBoxItem>1 分钟</ComboBoxItem>
                            <ComboBoxItem>5 分钟</ComboBoxItem>
                            <ComboBoxItem>30 分钟</ComboBoxItem>
                        </ComboBox>
                        <ui:Button x:Name="btnMock" Content="模拟数据" Appearance="Secondary" Click="OnToggleMock" />
                    </StackPanel>

                    <skia:SKElement x:Name="skElement" PaintSurface="OnPaintSurface" Height="300" />
                    <StackPanel x:Name="channelLegend" Orientation="Horizontal" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
