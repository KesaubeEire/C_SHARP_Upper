<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.TrendChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="趋势图"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!-- Section header -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="3"
                        Height="18"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorAttentionBrush}"
                        CornerRadius="2" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontTypography="Subtitle"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="趋势图" />
                    <ui:TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="变频器 · 滑台 · 圆盘" />
                </Grid>
            </Border>

            <!-- 控制栏 -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <WrapPanel HorizontalAlignment="Right">
                    <ui:TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="时间范围" />
                    <ComboBox
                        x:Name="timeRangeCombo"
                        Width="130"
                        SelectedIndex="4"
                        SelectionChanged="OnTimeRangeChanged" />
                    <Rectangle
                        Width="1"
                        Height="24"
                        Margin="12,0"
                        Fill="{DynamicResource ControlElevationBorderBrush}" />
                    <ui:Button
                        x:Name="btnMock"
                        Appearance="Secondary"
                        Click="OnToggleMock"
                        Content="模拟数据">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Beaker24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>
            </Border>

            <!-- 趋势图 -->
            <Border
                MinHeight="420"
                Margin="0,0,0,12"
                Padding="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:CartesianChartKesaTrend
                        x:Name="trendChart"
                        Grid.Row="0"
                        Margin="8"
                        AnimationsSpeed="00:00:00.050"
                        Background="Transparent"
                        FillOpacity="0"
                        GeometrySize="0"
                        LineSmoothness="0.2"
                        LineStrokeThickness="3"
                        TooltipPosition="Top"
                        ZoomMode="X"
                        AxisLabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                        AxisGridBrush="{DynamicResource TextFillColorSecondaryBrush}"
                        TooltipBgBrush="{DynamicResource CardBackgroundBrush}"
                        TooltipTextBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                    <!-- 图例 + 实时值 -->
                    <Border
                        x:Name="legendBar"
                        Grid.Row="1"
                        Padding="12,8"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                        <StackPanel x:Name="legendPanel" Orientation="Horizontal" />
                    </Border>
                </Grid>
            </Border>

            <!-- 设备控制 -->
            <Border
                Padding="20"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorCautionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="设备控制" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 左侧：3×5 按钮 -->
                        <Grid MinWidth="600" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 传送带 -->
                            <ui:Button
                                Grid.Row="0" Grid.Column="0"
                                Width="120" Height="40" Margin="4"
                                Appearance="Success"
                                Content="传送带正转"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="1.0.0" />
                            <ui:Button
                                Grid.Row="0" Grid.Column="1"
                                Width="120" Height="40" Margin="4"
                                Appearance="Caution"
                                Content="传送带暂停"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="1.10.4" />
                            <ui:Button
                                Grid.Row="0" Grid.Column="2"
                                Width="120" Height="40" Margin="4"
                                Appearance="Primary"
                                Content="传送带反转"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="1.0.1" />

                            <!-- 滑台 -->
                            <ui:Button
                                Grid.Row="1" Grid.Column="0"
                                Width="120" Height="40" Margin="4"
                                Appearance="Success"
                                Content="滑台正转"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="6.0.2" />
                            <ui:Button
                                Grid.Row="1" Grid.Column="1"
                                Width="120" Height="40" Margin="4"
                                Appearance="Caution"
                                Content="滑台回原"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="6.6.0" />
                            <ui:Button
                                Grid.Row="1" Grid.Column="2"
                                Width="120" Height="40" Margin="4"
                                Appearance="Primary"
                                Content="滑台反转"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="6.0.3" />

                            <!-- 圆盘 -->
                            <ui:Button
                                Grid.Row="2" Grid.Column="0"
                                Width="120" Height="40" Margin="4"
                                Appearance="Success"
                                Content="圆盘正转"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="7.0.4" />
                            <ui:Button
                                Grid.Row="2" Grid.Column="1"
                                Width="120" Height="40" Margin="4"
                                Appearance="Caution"
                                Content="圆盘回原"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="7.0.3" />
                            <ui:Button
                                Grid.Row="2" Grid.Column="2"
                                Width="120" Height="40" Margin="4"
                                Appearance="Primary"
                                Content="圆盘反转"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="7.0.5" />

                            <!-- 滑台使能（点按取反） -->
                            <ui:Button
                                Grid.Row="1" Grid.Column="3"
                                Width="120" Height="40" Margin="4"
                                Appearance="Success"
                                Content="滑台使能"
                                Click="OnEnableToggleClick"
                                Tag="6.0.0" />
                            <ui:Button
                                Grid.Row="1" Grid.Column="4"
                                Width="120" Height="40" Margin="4"
                                Appearance="Caution"
                                Content="滑台复位"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="6.0.1" />

                            <!-- 圆盘使能（点按取反） -->
                            <ui:Button
                                Grid.Row="2" Grid.Column="3"
                                Width="120" Height="40" Margin="4"
                                Appearance="Success"
                                Content="圆盘使能"
                                Click="OnEnableToggleClick"
                                Tag="7.0.0" />
                            <ui:Button
                                Grid.Row="2" Grid.Column="4"
                                Width="120" Height="40" Margin="4"
                                Appearance="Caution"
                                Content="圆盘复位"
                                MouseLeave="OnMotorPressLeave"
                                PreviewMouseLeftButtonDown="OnMotorPressDown"
                                PreviewMouseLeftButtonUp="OnMotorPressUp"
                                Tag="7.0.1" />
                        </Grid>

                        <!-- 右侧：速度仪表 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <StackPanel>
                                <ui:TextBlock
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="圆盘速度" />
                                <plc:ServoGauge
                                    x:Name="gaugeDiscSpeed"
                                    MinValue="0" MaxValue="360"
                                    GreenMax="180" YellowMax="300" RedMax="360"
                                    UnitLabel="°/s"
                                    NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                    UnitBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="24,0,0,0">
                                <ui:TextBlock
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="步进速度" />
                                <plc:ServoGauge
                                    x:Name="gaugeStepSpeed"
                                    MinValue="0" MaxValue="100"
                                    GreenMax="50" YellowMax="80" RedMax="100"
                                    UnitLabel="mm/s"
                                    NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                    LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    TickBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    ValueBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                    UnitBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
