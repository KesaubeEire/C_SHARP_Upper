<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.TrendChartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
      xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Plc"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="趋势图">
    <ScrollViewer>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBlock FontTypography="Title" Text="实时趋势图" VerticalAlignment="Center" />
            <Separator Width="2" />
            <ComboBox x:Name="timeRangeCombo" SelectedIndex="0" Width="120">
                <ComboBoxItem>1 分钟</ComboBoxItem>
                <ComboBoxItem>5 分钟</ComboBoxItem>
                <ComboBoxItem>30 分钟</ComboBoxItem>
            </ComboBox>
            <ui:Button x:Name="btnMock" Content="模拟数据" Appearance="Secondary" Click="OnToggleMock" />
        </StackPanel>

        <skia:SKElement Grid.Row="1" x:Name="skElement" PaintSurface="OnPaintSurface" />

        <StackPanel Grid.Row="2" x:Name="channelLegend" Orientation="Horizontal" Margin="0,8,0,0" />
        </Grid>
    </ScrollViewer>
</Page>
