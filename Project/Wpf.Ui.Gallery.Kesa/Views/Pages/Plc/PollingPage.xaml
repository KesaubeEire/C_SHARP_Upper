<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.PollingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
      controls:PageControlDocumentation.Show="False"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Plc"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="轮询配置">
    <ScrollViewer>
        <StackPanel Margin="24">
        <ui:TextBlock FontTypography="Title" Text="轮询配置" />
        <Separator />

        <GroupBox Header="轮询参数">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="间隔 (ms)" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="intervalInput" Text="500" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="延迟" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="latencyText" Text="--" Margin="0,4" />
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="btnStart" Content="▶ 启动轮询" Appearance="Primary" Click="OnStart" />
            <ui:Button x:Name="btnStop" Content="■ 停止轮询" Appearance="Secondary" Click="OnStop" IsEnabled="False" />
        </StackPanel>

        <Border x:Name="statusBar" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="statusIndicator" Width="12" Height="12" Fill="#666" VerticalAlignment="Center" />
                <TextBlock x:Name="statusText" Text="就绪" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
