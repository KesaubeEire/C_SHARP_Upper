<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.DbMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
      xmlns:models="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
      controls:PageControlDocumentation.Show="False"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="DB 块监控"
      mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">

        <!-- ===== 顶部：导入 + 配置 ===== -->
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <!-- 第一行：导入 + DB号 + 读取 + 清除 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" x:Name="btnImportDb"
                               Content="📂 导入 .db"
                               Appearance="Primary"
                               Click="OnImportDb"
                               Margin="0,0,4,0" />
                    <ui:Button Grid.Column="1"
                               Content="📂 导入 .udt"
                               Click="OnImportUdt"
                               Margin="4,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="DB 号:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0" />
                        <TextBox x:Name="dbNumberInput" Text="1"
                                 Width="60" Height="30"
                                 HorizontalContentAlignment="Center"
                                 VerticalAlignment="Center" Margin="4,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="4" x:Name="btnReadDb"
                               Content="📡 读取 DB"
                               Appearance="Success"
                               Click="OnReadDb"
                               Margin="4,0" />
                    <ui:Button Grid.Column="6"
                               Content="✕ 清除"
                               Appearance="Secondary"
                               Click="OnClearDb"
                               Margin="8,0,0,0" />
                </Grid>

                <!-- DB 信息 + UDT 提示 -->
                <TextBlock x:Name="dbInfoText" Text="未导入 DB 文件"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12" Margin="0,8,0,0" />
                <TextBlock x:Name="udtHintText" Text=""
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== 中间：变量列表 ===== -->
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="0"
                MinHeight="300" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="偏移量" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="变量名" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="数据处理" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="数据类型" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="大小" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="值" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="6" Text="注释" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- 变量列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                    <Grid>
                        <ItemsControl x:Name="variableList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DbVariableDisplay}">
                                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 偏移量 -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OffsetDisplay}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- 变量名 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UdtName, StringFormat=' [{0}]'}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontWeight="Normal"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>

                                            <!-- 数据处理 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">

                                                <!-- BOOL 操作按钮 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding BoolVis}">
                                                    <ui:Button Content="按1松0"
                                                               Appearance="Primary"
                                                               Margin="0,0,6,0"
                                                               PreviewMouseLeftButtonDown="OnBitPressDown"
                                                               PreviewMouseLeftButtonUp="OnBitPressUp"
                                                               MouseLeave="OnBitPressLeave" />
                                                    <ui:Button Content="取反"
                                                               Appearance="Caution"
                                                               PreviewMouseLeftButtonDown="OnBitToggle" />
                                                </StackPanel>

                                                <!-- 数值编辑 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding EditVis}">
                                                    <TextBox Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,0,6,0" Width="Auto"
                                                             VerticalAlignment="Center"/>
                                                    <ui:Button Content="改动"
                                                               Appearance="Success"
                                                               Click="OnValueEdit" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 数据类型 -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DataType}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- 大小 -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Size, StringFormat='{}{0}B'}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <!-- 值 -->
                                            <Border Grid.Column="5"
                                                    Background="{DynamicResource TextBoxBackground}"
                                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="8,3" Height="28"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}"
                                                         FontWeight="Bold"
                                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <!-- 注释 -->
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding Comment}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 空状态 -->
                        <Border x:Name="emptyState"
                                Height="200" Visibility="Visible"
                                Background="Transparent">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="请导入 .db 文件并点击读取"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== 底部状态栏 ===== -->
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 连接状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="connIndicator" Width="10" Height="10"
                             Fill="{DynamicResource TextFillColorDisabledBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="statusText" Text="未连接"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,16,0" />
                </StackPanel>

                <!-- DB 大小 -->
                <TextBlock Grid.Column="1" x:Name="dbSizeText" Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />

                <!-- 操作信息 -->
                <TextBlock Grid.Column="3" x:Name="operStatusText" Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

    </StackPanel>
</Page>
