<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.IoMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
      xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
      controls:PageControlDocumentation.Show="False"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="I/Q/M 区监控"
      mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Margin="0,0,0,12" FontTypography="Title" Text="I / Q / M 区监控" />

        <!-- ===== I 区（输入 · 只读） ===== -->
        <plc:AreaPanel x:Name="iPanel" AreaType="I" IsReadOnly="True" />

        <!-- ===== Q 区（输出 · 可读写） ===== -->
        <plc:AreaPanel x:Name="qPanel" AreaType="Q" Margin="0,16,0,0" />

        <!-- ===== M 区（位存储 · 可读写） ===== -->
        <plc:AreaPanel x:Name="mPanel" AreaType="M" Margin="0,16,0,0" />
    </StackPanel>
</Page>
