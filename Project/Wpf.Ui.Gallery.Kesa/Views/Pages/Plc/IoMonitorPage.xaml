<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.IoMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="I/Q/M 区监控"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <!-- Section header -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="3"
                        Height="18"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorAttentionBrush}"
                        CornerRadius="2" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontTypography="Subtitle"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="I/Q/M 区监控" />
                    <ui:TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="输入 / 输出 / 位存储" />
                </Grid>
            </Border>

            <!-- I 区（输入 · 只读） -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="I 区（输入）" />
                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                            CornerRadius="4">
                            <ui:TextBlock
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="只读" />
                        </Border>
                    </Grid>
                    <plc:AreaPanel x:Name="iPanel" AreaType="I" IsReadOnly="True" />
                </StackPanel>
            </Border>

            <!-- Q 区（输出 · 可读写） -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorCautionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Q 区（输出）" />
                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            Background="{DynamicResource SystemFillColorCautionBrush}"
                            CornerRadius="4">
                            <ui:TextBlock
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="可读写" />
                        </Border>
                    </Grid>
                    <plc:AreaPanel x:Name="qPanel" AreaType="Q" />
                </StackPanel>
            </Border>

            <!-- M 区（位存储 · 可读写） -->
            <Border
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="M 区（位存储）" />
                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="4">
                            <ui:TextBlock
                                FontTypography="Caption"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="可读写" />
                        </Border>
                    </Grid>
                    <plc:AreaPanel x:Name="mPanel" AreaType="M" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
