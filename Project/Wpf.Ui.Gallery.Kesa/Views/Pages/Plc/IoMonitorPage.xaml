<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.IoMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Controls.Plc"
      xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Plc"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="I/Q/M 监控">
    <ScrollViewer>
        <StackPanel Margin="16">
        <ui:TextBlock FontTypography="Title" Text="I / Q / M 区监控" />
        <Separator />
        <plc:AreaPanel x:Name="iPanel" AreaType="I" IsReadOnly="True" />
        <plc:AreaPanel x:Name="qPanel" AreaType="Q" />
        <plc:AreaPanel x:Name="mPanel" AreaType="M" AddressText="" />
        </StackPanel>
    </ScrollViewer>
</Page>
