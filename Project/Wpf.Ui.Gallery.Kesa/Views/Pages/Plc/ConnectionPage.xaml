<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.ConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="PLC 连接"
      mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Margin="0,0,0,12" FontTypography="Title" Text="PLC 连接配置" />

        <controls:ControlExample Margin="0" HeaderText="本机网卡">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="adapterCombo" DisplayMemberPath="Display" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,32,0,0" HeaderText="PLC 参数">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 地址" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ipInput" Text="192.168.0.1" Margin="0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="portInput" Text="102" Margin="0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="机架 (Rack)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="rackInput" Text="0" Margin="0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="槽位 (Slot)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="slotInput" Text="1" Margin="0,6" />
                </Grid>
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,32,0,0" HeaderText="连接控制">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button x:Name="btnConnect" Content="连接 PLC" Appearance="Primary" Click="OnConnect" Margin="0,0,8,0" />
                        <ui:Button x:Name="btnDisconnect" Content="断开" Appearance="Secondary" Click="OnDisconnect" IsEnabled="False" />
                    </StackPanel>

                    <Border x:Name="statusBar" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="statusIndicator" Width="12" Height="12" Fill="{DynamicResource TextFillColorDisabledBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="statusText" Text="未连接" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
