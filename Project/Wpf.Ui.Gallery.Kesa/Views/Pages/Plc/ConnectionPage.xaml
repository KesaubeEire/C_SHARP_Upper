<Page x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.ConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Plc"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="PLC 连接">
 <ScrollViewer Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <StackPanel Margin="24">
   <ui:TextBlock FontTypography="Title" Text="PLC 连接配置" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
   <Separator />

   <GroupBox Header="本机网卡">
    <ComboBox x:Name="adapterCombo" DisplayMemberPath="Display" />
   </GroupBox>

   <GroupBox Header="PLC 参数">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120" />
      <ColumnDefinition Width="*" />
     </Grid.ColumnDefinitions>

     <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 地址" VerticalAlignment="Center" />
     <TextBox Grid.Row="0" Grid.Column="1" x:Name="ipInput" Text="192.168.0.1" Margin="0,4" />

     <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" VerticalAlignment="Center" />
     <TextBox Grid.Row="1" Grid.Column="1" x:Name="portInput" Text="102" Margin="0,4" />

     <TextBlock Grid.Row="2" Grid.Column="0" Text="机架 (Rack)" VerticalAlignment="Center" />
     <TextBox Grid.Row="2" Grid.Column="1" x:Name="rackInput" Text="0" Margin="0,4" />

     <TextBlock Grid.Row="3" Grid.Column="0" Text="槽位 (Slot)" VerticalAlignment="Center" />
     <TextBox Grid.Row="3" Grid.Column="1" x:Name="slotInput" Text="1" Margin="0,4" />
    </Grid>
   </GroupBox>

   <StackPanel Orientation="Horizontal">
    <ui:Button x:Name="btnConnect" Content="连接 PLC" Appearance="Primary" Click="OnConnect" />
    <ui:Button x:Name="btnDisconnect" Content="断开" Appearance="Secondary" Click="OnDisconnect" IsEnabled="False" />
   </StackPanel>

   <Border x:Name="statusBar" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal">
     <Ellipse x:Name="statusIndicator" Width="12" Height="12" Fill="#666" VerticalAlignment="Center" />
     <TextBlock x:Name="statusText" Text="未连接" VerticalAlignment="Center" />
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Page>
