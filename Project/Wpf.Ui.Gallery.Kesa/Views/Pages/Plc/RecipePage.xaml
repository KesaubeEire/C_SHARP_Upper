<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.RecipePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.Plc"
    Title="配方管理"
    d:DataContext="{d:DesignInstance vm:RecipeViewModel, IsDesignTimeCreatable=False}"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left Panel: Recipe List ===== -->
        <Border
            Grid.Column="0"
            Padding="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontTypography="BodyStrong"
                    Text="配方列表" />

                <ui:Button
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    Appearance="Primary"
                    Command="{Binding NewRecipeCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                    新建配方
                </ui:Button>

                <!-- Recipe list -->
                <ListBox
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Recipes}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="plc:RecipeMeta">
                            <Border
                                Padding="8,6"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontTypography="Body"
                                        Text="{Binding Name}" />

                                    <ui:TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="v" />
                                    <ui:TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Version}" />

                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom actions -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <ui:Button
                        Margin="0,0,0,4"
                        Appearance="Secondary"
                        Command="{Binding RefreshRecipeListCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                        刷新
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Divider ===== -->
        <Rectangle
            Grid.Column="1"
            Width="1"
            Margin="12,0"
            Fill="{DynamicResource ControlElevationBorderBrush}" />

        <!-- ===== Right Panel: Recipe Editor ===== -->
        <Border
            Grid.Column="2"
            Padding="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid IsEnabled="{Binding HasRecipeSelected}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Recipe header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontTypography="Subtitle"
                        Text="配方编辑器" />
                    <ui:TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding CurrentVersion, StringFormat=版本: v{0}}" />

                    <!-- Recipe name -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontTypography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="名称:" />
                        <ui:TextBox
                            Grid.Column="1"
                            Text="{Binding CurrentRecipeName, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="输入配方名称" />
                    </Grid>

                    <!-- Recipe description -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontTypography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="描述:" />
                        <ui:TextBox
                            Grid.Column="1"
                            Text="{Binding CurrentRecipeDescription, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="配方说明（可选）" />
                    </Grid>
                </Grid>

                <!-- ===== Parameters DataGrid ===== -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        FontTypography="BodyStrong"
                        Text="参数列表" />

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CanUserAddRows="True"
                        CanUserDeleteRows="True"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        ItemsSource="{Binding CurrentParameters}"
                        SelectionUnit="FullRow"
                        RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="120"
                                Header="参数名"
                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="*"
                                Header="值"
                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="80"
                                Header="单位"
                                Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="80"
                                Header="地址"
                                Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="80"
                                Header="缩放"
                                Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="80"
                                Header="偏移"
                                Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ===== Parameter toolbar ===== -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Command="{Binding AddParameterCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                        添加参数
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Command="{Binding RemoveParameterCommand}"
                        CommandParameter="{Binding SelectedParameter}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Subtract24" />
                        </ui:Button.Icon>
                        删除选中
                    </ui:Button>
                </StackPanel>

                <!-- ===== Action buttons ===== -->
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}" />

                    <ui:Button
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Appearance="Success"
                        Command="{Binding SaveRecipeCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                        保存配方
                    </ui:Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
