<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Plc.RecipePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plc="clr-namespace:Wpf.Ui.Gallery.Models.Plc"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.Plc"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    Title="配方管理"
    d:DataContext="{d:DesignInstance vm:RecipeViewModel, IsDesignTimeCreatable=False}"
    controls:PageControlDocumentation.Show="False"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- Left Panel: Recipe List -->
        <!-- ============================================================ -->
        <Border
            Grid.Column="0"
            Padding="0"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border
                    Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="配方列表" />
                    </Grid>
                </Border>

                <!-- Search -->
                <Border Grid.Row="1" Padding="16,8,16,4">
                    <ui:TextBox
                        PlaceholderText="搜索配方..."
                        Text="{Binding RecipeSearchText, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </Border>

                <!-- Category filter -->
                <Border Grid.Row="2" Padding="16,4,16,8">
                    <ComboBox
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategoryFilter}" />
                </Border>

                <!-- New recipe button -->
                <Border Grid.Row="3" Padding="16,0,16,8">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding NewRecipeCommand}"
                        Width="268">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24" />
                        </ui:Button.Icon>
                        新建配方
                    </ui:Button>
                </Border>

                <!-- Recipe list -->
                <ListBox
                    Grid.Row="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding FilteredRecipes}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="plc:RecipeMeta">
                            <Border
                                Padding="16,8"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <ui:TextBlock
                                            FontTypography="Body"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />
                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="4,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorInputActiveBrush}"
                                            CornerRadius="3"
                                            Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                            <ui:TextBlock
                                                FontTypography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Category}" />
                                        </Border>
                                    </StackPanel>

                                    <ui:TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Version, StringFormat=v{0}}" />

                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer actions -->
                <Border
                    Grid.Row="5"
                    Padding="16,8"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding FilteredRecipes.Count, StringFormat={}{0} 个配方}" />

                        <ui:Button
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Command="{Binding CopyRecipeCommand}"
                            CommandParameter="{Binding SelectedRecipe}"
                            IsEnabled="{Binding HasRecipeSelected}"
                            ToolTip="复制配方">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button
                            Grid.Column="2"
                            Appearance="Secondary"
                            Command="{Binding RefreshRecipeListCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Divider -->
        <!-- ============================================================ -->
        <Rectangle
            Grid.Column="1"
            Width="1"
            Fill="{DynamicResource ControlElevationBorderBrush}" />

        <!-- ============================================================ -->
        <!-- Right Panel: Recipe Editor -->
        <!-- ============================================================ -->
        <Border
            Grid.Column="2"
            Padding="0"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsEnabled="{Binding HasRecipeSelected}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Border
                    Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="3"
                            Height="18"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBrush}"
                            CornerRadius="2" />
                        <ui:TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontTypography="Subtitle"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="配方编辑器" />
                        <ui:TextBlock
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding CurrentVersion, StringFormat=版本: v{0}}" />
                        <ui:Button
                            Grid.Column="3"
                            Appearance="Danger"
                            Command="{Binding DeleteRecipeCommand}"
                            CommandParameter="{Binding SelectedRecipe}"
                            ToolTip="删除配方">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>

                <!-- ===== Recipe metadata ===== -->
                <Border
                    Grid.Row="1"
                    Padding="16,12"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <StackPanel>
                        <!-- Name + Category row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="配方名称" />
                                <ui:TextBox
                                    Text="{Binding CurrentRecipeName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="输入配方名称" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="分类标签" />
                                <ui:TextBox
                                    Text="{Binding CurrentRecipeCategory, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="例如：温度配方" />
                            </StackPanel>
                        </Grid>

                        <!-- Description + DB config row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="描述 / 标签（逗号分隔）" />
                                <ui:TextBox
                                    Text="{Binding CurrentRecipeDescription, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="配方说明（可选）" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="默认 DB 号" />
                                <ui:NumberBox
                                    Minimum="1"
                                    Maximum="999"
                                    Value="{Binding DefaultDbNumber}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Parameters section ===== -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Parameters header + toolbar -->
                    <Border
                        Grid.Row="0"
                        Padding="16,8"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontTypography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="参数列表" />
                            <ui:TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding CurrentParameters.Count, StringFormat={}{0} 个参数}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Success"
                                    Command="{Binding DownloadToPlcCommand}"
                                    ToolTip="下载到 PLC">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowUpload24" />
                                    </ui:Button.Icon>
                                    写入 PLC
                                </ui:Button>
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Primary"
                                    Command="{Binding UploadFromPlcCommand}"
                                    ToolTip="从 PLC 上传">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                                    </ui:Button.Icon>
                                    读取 PLC
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Filter & group bar -->
                    <Border
                        Grid.Row="1"
                        Padding="16,6"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox
                                Grid.Column="0"
                                PlaceholderText="搜索参数..."
                                Text="{Binding ParameterSearchText, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Search24" />
                                </ui:TextBox.Icon>
                            </ui:TextBox>

                            <ComboBox
                                Grid.Column="2"
                                ItemsSource="{Binding ParameterGroups}"
                                SelectedItem="{Binding SelectedParameterGroup}" />

                            <ui:Button
                                Grid.Column="4"
                                Margin="4,0"
                                Appearance="Secondary"
                                Command="{Binding AddParameterCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                                添加
                            </ui:Button>
                            <ui:Button
                                Grid.Column="5"
                                Margin="4,0"
                                Appearance="Secondary"
                                Command="{Binding RemoveParameterCommand}"
                                CommandParameter="{Binding SelectedParameter}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Subtract24" />
                                </ui:Button.Icon>
                                删除
                            </ui:Button>
                            <ui:Button
                                Grid.Column="6"
                                Margin="4,0"
                                Appearance="Secondary"
                                Command="{Binding ImportCsvCommand}"
                                ToolTip="从 CSV 导入">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                Grid.Column="7"
                                Margin="4,0,0,0"
                                Appearance="Secondary"
                                Command="{Binding ExportCsvCommand}"
                                ToolTip="导出 CSV">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="SaveEdit24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- Parameters DataGrid -->
                    <DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="True"
                        CanUserDeleteRows="True"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        ItemsSource="{Binding FilteredParameters}"
                        SelectionUnit="FullRow"
                        RowHeaderWidth="0"
                        SelectedItem="{Binding SelectedParameter, Mode=TwoWay}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="40"
                                Header="#"
                                IsReadOnly="True"
                                Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=Header}" />

                            <!-- Group indicator column (colored bar) -->
                            <DataGridTemplateColumn Width="4" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="4"
                                            Height="20"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{DynamicResource SystemFillColorAttentionBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="120"
                                Header="参数名"
                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="*"
                                Header="值"
                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="60"
                                Header="单位"
                                Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="70"
                                Header="地址"
                                Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="70"
                                Header="缩放"
                                Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="70"
                                Header="偏移"
                                Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="90"
                                Header="分组"
                                Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="70"
                                Header="PLC 类型"
                                Binding="{Binding PlcDataType, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="50"
                                Header="DB"
                                Binding="{Binding DbNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ===== Parameter actions ===== -->
                <Border
                    Grid.Row="3"
                    Padding="16,8"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            Command="{Binding DuplicateParameterCommand}"
                            CommandParameter="{Binding SelectedParameter}"
                            IsEnabled="{Binding SelectedParameter, Converter={StaticResource NullToBoolConverter}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                            复制参数
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- ===== Footer ===== -->
                <Border
                    Grid.Row="4"
                    Padding="16,10"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- PLC status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{Binding IsPlcConnected, Converter={StaticResource IndicatorConverter}}" />
                            <ui:TextBlock
                                Margin="6,0,16,0"
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding PlcStatusText}" />
                        </StackPanel>

                        <!-- Status text -->
                        <ui:TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StatusText}" />

                        <!-- Save button -->
                        <ui:Button
                            Grid.Column="3"
                            Appearance="Success"
                            Command="{Binding SaveRecipeCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Save24" />
                            </ui:Button.Icon>
                            保存配方
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
