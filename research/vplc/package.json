{
  "name": "vplc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/vplc.ts",
    "dev:ui": "pnpm --filter vplc-frontend dev",
    "launch": "concurrently -n backend,frontend -c yellow,cyan \"pnpm dev\" \"pnpm dev:ui\"",
    "start": "tsx server/vplc.ts",
    "client": "tsx server/vplcClient.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3"
  }
}
